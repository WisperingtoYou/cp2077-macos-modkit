@@ -0,0 +1,37 @@
+cmake_minimum_required(VERSION 3.20)
+project(InputLoader VERSION 0.2.3 LANGUAGES CXX)
+
+# macOS arm64 build of Input Loader as a RED4ext-macos plugin: cmake -S macos -B build-mac.
+# The Windows build stays on the top-level CMakeLists.txt (cyberpunk_cmake).
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_OSX_ARCHITECTURES "arm64")
+set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0")
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
+set(ROOT "${CMAKE_CURRENT_SOURCE_DIR}/..")
+
+set(RED4EXT_SDK_DIR "${ROOT}/../RED4ext.SDK" CACHE PATH "RED4ext.SDK (macOS) repository root")
+if(NOT EXISTS "${RED4EXT_SDK_DIR}/include/RED4ext/RED4ext.hpp")
+    message(FATAL_ERROR "RED4ext.SDK not found at ${RED4EXT_SDK_DIR}; pass -DRED4EXT_SDK_DIR=<path>.")
+endif()
+
+include(FetchContent)
+set(SPDLOG_BUILD_SHARED OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(spdlog
+    URL https://github.com/gabime/spdlog/archive/refs/tags/v1.16.0.tar.gz
+    URL_HASH SHA256=8741753e488a78dd0d0024c980e1fb5b5c85888447e309d9cb9d949bdb52aa3e)
+FetchContent_Declare(pugixml
+    URL https://github.com/zeux/pugixml/archive/refs/tags/v1.14.tar.gz
+    URL_HASH SHA256=610f98375424b5614754a6f34a491adbddaaec074e9044577d965160ec103d2e)
+FetchContent_MakeAvailable(spdlog pugixml)
+
+add_library(InputLoader SHARED "${ROOT}/src/Main.cpp" "${ROOT}/src/Utils.cpp")
+set_target_properties(InputLoader PROPERTIES OUTPUT_NAME "InputLoader" PREFIX "" SUFFIX ".dylib")
+target_include_directories(InputLoader PRIVATE "${ROOT}/src" "${ROOT}/include" "${RED4EXT_SDK_DIR}/include")
+target_compile_definitions(InputLoader PRIVATE RED4EXT_PLATFORM_MACOS
+    MOD_VERSION_STR="${PROJECT_VERSION}" MOD_VERSION_MAJOR=${PROJECT_VERSION_MAJOR}
+    MOD_VERSION_MINOR=${PROJECT_VERSION_MINOR} MOD_VERSION_PATCH=${PROJECT_VERSION_PATCH})
+target_compile_options(InputLoader PRIVATE -fvisibility=hidden -Wno-deprecated-declarations)
+target_link_libraries(InputLoader PRIVATE spdlog::spdlog pugixml::static)
+target_link_options(InputLoader PRIVATE -undefined dynamic_lookup)
