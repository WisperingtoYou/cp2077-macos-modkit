diff --git a/compiler/src/source_map.rs b/compiler/src/source_map.rs
index f54cc2e..193c204 100644
--- a/compiler/src/source_map.rs
+++ b/compiler/src/source_map.rs
@@ -94,8 +94,17 @@ fn dir_file_iter(path: &Path) -> impl Iterator<Item = PathBuf> + use<> {
     if path.is_file() {
         Either::Left(iter::once(path.to_path_buf()))
     } else {
+        // Visit files in the order a Windows (NTFS) directory listing gives: each folder sorted by name,
+        // case-insensitively. Annotations like @wrapMethod on a method another mod adds with @addMethod depend on
+        // that order, and APFS on macOS lists entries in no particular order.
         let iter = WalkDir::new(path)
             .follow_links(true)
+            .sort_by(|a, b| {
+                a.file_name()
+                    .to_string_lossy()
+                    .to_uppercase()
+                    .cmp(&b.file_name().to_string_lossy().to_uppercase())
+            })
             .into_iter()
             .filter_map(Result::ok)
             .filter(|entry| entry.path().extension() == Some(OsStr::new("reds")))
