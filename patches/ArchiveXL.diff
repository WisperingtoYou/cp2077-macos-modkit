diff --git a/src/App/Extensions/ExtensionGuard.hpp b/src/App/Extensions/ExtensionGuard.hpp
new file mode 100644
index 0000000..20f07b7
--- /dev/null
+++ b/src/App/Extensions/ExtensionGuard.hpp
@@ -0,0 +1,201 @@
+#pragma once
+
+#include <cstdint>
+#include <shared_mutex>
+
+namespace App
+{
+// Hot reload safety (ArchiveXL.Reload()).
+//
+// Configure/Load/Reload clear and rebuild extension state (maps of fixes, scopes, patches, configs). Hook handlers
+// read that state on game worker threads (resource loader, job dispatcher). One process-wide reader/writer lock keeps
+// them apart:
+//
+// - ExtensionWriteGuard (exclusive): the startup Configure()+Load(), OnDepotReady/OnTweakDBReady and the runtime
+//   Configure()+Reload(). These run on the main thread.
+// - ExtensionReadGuard (shared): every handler, or accessor called from a handler, that reads rebuilt state.
+//
+// Rules that keep this deadlock free:
+// 1. A read guard does nothing on the thread that holds the write guard. The rebuild can start resource loads and
+//    hooks on its own thread; a shared lock there would block on itself.
+// 2. A read guard does nothing when the thread already holds a read guard (nested hooks, a guarded handler calling a
+//    guarded accessor). std::shared_mutex blocks new readers when a writer waits, so a second shared lock on the same
+//    thread could block on the waiting writer, which in turn waits for the first shared lock.
+// 3. Code that holds a read guard must not wait for other threads (job waits, resource waits, synchronous loads,
+//    calls to the original game function that can do so). The other thread can block on the lock while a writer
+//    waits, or the writer itself can be the thread it waits for. Handlers copy what they need under the guard and
+//    release it before such work.
+// 4. Lock order: the extension guard is the outermost lock for the writer. Configure/Reload must not take a lock
+//    that a handler can hold while it reaches a read guard (it would invert the order).
+// 5. Code that holds the write guard must not wait for jobs that run guarded hooks. Use ExtensionWriteYield around
+//    such waits (the journal reload waits for the journal load job, which runs the journal hooks).
+//
+// Guarded readers (see the call sites):
+// - ResourceMetaExtension: InScope, GetList, ExpandList, GetFix (return copies).
+// - ResourcePatchExtension: GetPatchList, IsPatchResource (return copies). This covers all its handlers, including
+//   OnMeshResourceLoad and the Hook/HookWrap ones that call the original function.
+// - AnimationExtension::OnInitializeAnimations, QuestPhaseExtension::OnPhasePreload (whole handler, no waits).
+// - FactoryIndexExtension::OnLoadFactoryAsync (copies the factory list, calls the game unguarded).
+// - LocalizationExtension: OnLoadTexts, OnLoadSubtitles, OnLoadVoiceOvers, OnLoadLipsyncs (copy m_configs, load
+//   resources unguarded).
+// - JournalExtension: OnLoadJournal, OnInitializeRoot, OnMappinDataLoaded (whole handler), OnGetMappinData,
+//   OnGetPoiData (guard after the original call; mappin copied, resolved unguarded, written back guarded).
+// - CustomizationExtension: option/appearance handlers that read the custom entry names and app overrides,
+//   MergeCustomEntries (waits for the base resources before it takes the guard).
+// - PuppetStateExtension::GetBodyType.
+// - GarmentExtension::RegisterComponentOverrides (tag definitions from Configure). Configure no longer takes s_mutex:
+//   handlers hold s_mutex across game calls that can reach guarded hooks (s_mutex -> read guard), so the writer must
+//   not take s_mutex after the write guard. The rest of the Garment state is runtime state under s_mutex.
+//
+// Not guarded, and why:
+// - ResourceLinkExtension: its maps have their own locks (s_linksLock, s_copiesLock, s_mappingsLock), also taken by
+//   Configure.
+// - WorldStreamingExtension: s_sectors has s_sectorsLock, taken by Configure and OnSectorPostLoad; OnRegisterSpots
+//   reads no ArchiveXL state.
+// - MeshExtension, AttachmentExtension, InkSpawnerExtension, TransmogExtension: no Configure/Reload state; their
+//   state has its own locks or comes from TweakDB/resources.
+// - QuestPhase OnGameRestored/OnQuestStart: s_forced is filled by the phase hook, never cleared by a reload.
+class ExtensionConfigGuard
+{
+public:
+    static std::shared_mutex& Mutex()
+    {
+        static std::shared_mutex s_mutex;
+        return s_mutex;
+    }
+
+    static bool IsExclusiveOwner()
+    {
+        return t_exclusiveOwner;
+    }
+
+    static bool IsHeldByCurrentThread()
+    {
+        return t_exclusiveOwner || t_sharedDepth > 0;
+    }
+
+private:
+    friend class ExtensionReadGuard;
+    friend class ExtensionWriteGuard;
+    friend class ExtensionWriteYield;
+
+    inline static thread_local bool t_exclusiveOwner = false;
+    inline static thread_local uint32_t t_sharedDepth = 0;
+};
+
+class ExtensionReadGuard
+{
+public:
+    ExtensionReadGuard()
+    {
+        if (ExtensionConfigGuard::t_exclusiveOwner)
+            return;
+
+        if (ExtensionConfigGuard::t_sharedDepth++ == 0)
+        {
+            ExtensionConfigGuard::Mutex().lock_shared();
+        }
+
+        m_active = true;
+    }
+
+    ~ExtensionReadGuard()
+    {
+        Unlock();
+    }
+
+    void Unlock()
+    {
+        if (!m_active)
+            return;
+
+        m_active = false;
+
+        if (--ExtensionConfigGuard::t_sharedDepth == 0)
+        {
+            ExtensionConfigGuard::Mutex().unlock_shared();
+        }
+    }
+
+    ExtensionReadGuard(const ExtensionReadGuard&) = delete;
+    ExtensionReadGuard& operator=(const ExtensionReadGuard&) = delete;
+
+private:
+    bool m_active{false};
+};
+
+class ExtensionWriteGuard
+{
+public:
+    ExtensionWriteGuard()
+    {
+        // Nested write guard: already exclusive.
+        if (ExtensionConfigGuard::t_exclusiveOwner)
+            return;
+
+        // A thread inside a read guard cannot upgrade (it would wait for itself). The caller checks IsAcquired() and
+        // retries later.
+        if (ExtensionConfigGuard::t_sharedDepth > 0)
+        {
+            m_failed = true;
+            return;
+        }
+
+        ExtensionConfigGuard::Mutex().lock();
+        ExtensionConfigGuard::t_exclusiveOwner = true;
+        m_active = true;
+    }
+
+    ~ExtensionWriteGuard()
+    {
+        if (m_active)
+        {
+            ExtensionConfigGuard::t_exclusiveOwner = false;
+            ExtensionConfigGuard::Mutex().unlock();
+        }
+    }
+
+    [[nodiscard]] bool IsAcquired() const
+    {
+        return !m_failed;
+    }
+
+    ExtensionWriteGuard(const ExtensionWriteGuard&) = delete;
+    ExtensionWriteGuard& operator=(const ExtensionWriteGuard&) = delete;
+
+private:
+    bool m_active{false};
+    bool m_failed{false};
+};
+
+// Releases the write guard of the current thread for a scope, then takes it again. Use it around waits for game jobs
+// that run guarded hooks on other threads. The state must be consistent when the scope starts.
+class ExtensionWriteYield
+{
+public:
+    ExtensionWriteYield()
+    {
+        if (!ExtensionConfigGuard::t_exclusiveOwner)
+            return;
+
+        ExtensionConfigGuard::t_exclusiveOwner = false;
+        ExtensionConfigGuard::Mutex().unlock();
+        m_active = true;
+    }
+
+    ~ExtensionWriteYield()
+    {
+        if (m_active)
+        {
+            ExtensionConfigGuard::Mutex().lock();
+            ExtensionConfigGuard::t_exclusiveOwner = true;
+        }
+    }
+
+    ExtensionWriteYield(const ExtensionWriteYield&) = delete;
+    ExtensionWriteYield& operator=(const ExtensionWriteYield&) = delete;
+
+private:
+    bool m_active{false};
+};
+}
