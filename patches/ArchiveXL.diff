+#ifdef __APPLE__
+bool App::WorldWidgetLimitPatch::PatchCode(uint32_t* aAddress, uint32_t aInstruction)
+{
+    // The game's __TEXT is mapped R-X from a signed file; VM_PROT_COPY gives this process a private writable copy of
+    // the page. This runs at bootstrap, before any world (and ink world layer job) exists.
+    const auto pageSize = static_cast<uintptr_t>(vm_page_size);
+    const auto address = reinterpret_cast<uintptr_t>(aAddress);
+    const auto page = address & ~(pageSize - 1);
+    const auto length = ((address + sizeof(aInstruction) + pageSize - 1) & ~(pageSize - 1)) - page;
+
+    auto kr = mach_vm_protect(mach_task_self(), page, length, FALSE, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY);
+    if (kr != KERN_SUCCESS)
+    {
+        LogError("WorldWidgetComponent limit patch: making the code writable failed ({}).", kr);
+        return false;
+    }
+
+    __atomic_store_n(aAddress, aInstruction, __ATOMIC_RELEASE);
+
+    kr = mach_vm_protect(mach_task_self(), page, length, FALSE, VM_PROT_READ | VM_PROT_EXECUTE);
+    sys_icache_invalidate(aAddress, sizeof(aInstruction));
+
+    if (kr != KERN_SUCCESS)
+    {
+        LogError("WorldWidgetComponent limit patch: restoring code protection failed ({}).", kr);
+        return false;
+    }
+
+    return true;
+}
+#endif
