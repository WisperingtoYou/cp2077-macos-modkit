+// Trampoline page pool, reserved at the first hook (RED4ext's own, while the game is still loading) and used only when
+// the normal near/far allocation fails. Hooks attached later, often lazily from a worker thread (TweakXL's stat hooks),
+// need a free page within +-128 MiB or a region walk that finds one within +-4 GiB; once the game has mapped its heaps
+// around the image that failed now and then (kErrUnreachable, then TweakXL threw and the game aborted). Pool pages are
+// handed out once and never reused.
+constexpr size_t kPoolPages = 128;
+uintptr_t g_poolBase = 0;
+size_t g_poolNext = 0;
+bool g_poolOk[kPoolPages]{};
+bool g_poolTried = false;
+
+void ReservePool(uintptr_t target)
+{
+    if (g_poolTried)
+    {
+        return;
+    }
+    g_poolTried = true;
+
+    const uintptr_t size = kPoolPages * PageSize();
+    const uintptr_t nearLimit = (static_cast<uintptr_t>(1) << 25) * 4 - 4;
+    uint8_t* block = nullptr;
+    if (AllocateWindow(target, &block, nearLimit, 8192, false, size) ||
+        AllocateWindow(target, &block, (static_cast<uintptr_t>(1) << 32) - size, 16384, true, size))
+    {
+        // Re-create the block as one allocation per page at the same addresses, so a pool page is an independent VM
+        // entry exactly like a page from AllocateNear/AllocateFar (protection changes and region queries then see
+        // the same layout they always did). A page that can't be re-created is skipped.
+        g_poolBase = reinterpret_cast<uintptr_t>(block);
+        mach_vm_deallocate(mach_task_self(), g_poolBase, size);
+        for (size_t i = 0; i < kPoolPages; ++i)
+        {
+            mach_vm_address_t page = g_poolBase + i * PageSize();
+            g_poolOk[i] = mach_vm_allocate(mach_task_self(), &page, PageSize(), VM_FLAGS_FIXED) == KERN_SUCCESS;
+        }
+    }
