+// CET overlay input gating in the world: while the overlay is open (toggle key 50 = kVK_ANSI_Grave, as bound in
+// bindings.json), key presses must not reach the game's input actions; after it closes they must again.
+public func CpRunMenuChecks(scenario: String) -> Void {}
+
+public func CpRunWorldStep(player: ref<PlayerPuppet>, step: Int32) -> Float {
+    switch step {
+        case 0:
+            player.cpGateLogger = new CpGateLogger();
+            player.RegisterInputListener(player.cpGateLogger);
+            return 2.0;
+        case 1:
+            player.cpGateLogger.count = 0;
+            CpReport("{\"event\":\"PRESS\",\"key\":49}");
+            return 2.0;
+        case 2:
+            CpCheck("baseline_space_reaches_game", player.cpGateLogger.count > 0, ToString(player.cpGateLogger.count));
+            CpReport("{\"event\":\"PRESS\",\"key\":50}");
+            return 3.0;
+        case 3:
+            player.cpGateLogger.count = 0;
+            CpReport("{\"event\":\"PRESS\",\"key\":49}");
+            return 1.0;
+        case 4:
+            CpReport("{\"event\":\"PRESS\",\"key\":13}"); // W
+            return 2.0;
+        case 5:
+            CpCheck("overlay_open_blocks_keys", player.cpGateLogger.count == 0, ToString(player.cpGateLogger.count));
+            CpShot("overlay-open");
+            CpReport("{\"event\":\"PRESS\",\"key\":50}");
+            return 3.0;
+        case 6:
+            player.cpGateLogger.count = 0;
+            CpReport("{\"event\":\"PRESS\",\"key\":49}");
+            return 2.0;
+        case 7:
+            CpCheck("overlay_closed_keys_reach_game", player.cpGateLogger.count > 0, ToString(player.cpGateLogger.count));
+            return 1.0;
+    }
+    return -1.0;
+}
+
+@addField(PlayerPuppet)
+public let cpGateLogger: ref<CpGateLogger>;
+
+public class CpGateLogger {
+    public let count: Int32;
+    protected cb func OnAction(action: ListenerAction, consumer: ListenerActionConsumer) -> Bool {
+        let t = ListenerAction.GetType(action);
+        if Equals(t, gameinputActionType.BUTTON_PRESSED) || Equals(t, gameinputActionType.BUTTON_RELEASED) {
+            this.count += 1;
+            CpReport("{\"event\":\"ACTION\",\"name\":\"" + NameToString(ListenerAction.GetName(action)) + "\"}");
+        }
+        return false;
+    }
+}
diff --git a/tools/autotest/scenarios/codeware.reds b/tools/autotest/scenarios/codeware.reds
new file mode 100644
index 0000000..e6f2dc8
--- /dev/null
+++ b/tools/autotest/scenarios/codeware.reds
@@ -0,0 +1,57 @@
+module CpAutotest
+
+// Codeware (macOS port): main-menu checks of the core script APIs. Codeware's own scripts are staged by the runner.
+public func CpRunMenuChecks(scenario: String) -> Void {
+    let version = Codeware.Version();
+    CpCheck("codeware_version", StrLen(version) > 0, version);
+    CpCheck("codeware_require", Codeware.Require("1.20.0"), "");
+
+    let cls = Reflection.GetClass(n"PlayerPuppet");
+    CpCheck("reflection_get_class", IsDefined(cls), "");
+    if IsDefined(cls) {
+        CpCheck("reflection_parent", IsDefined(cls.GetParent()), NameToString(cls.GetParent().GetName()));
+        let funcs = cls.GetFunctions();
+        CpCheck("reflection_functions", ArraySize(funcs) > 100, ToString(ArraySize(funcs)));
+        CpCheck("reflection_property", IsDefined(Reflection.GetClass(n"gameObject").GetProperty(n"uiSlotComponent"))
+            || ArraySize(Reflection.GetClass(n"gameObject").GetProperties()) > 0, "");
+    }
+    let en = Reflection.GetEnum(n"gamedataStatType");
+    let consts: array<ref<ReflectionConst>>;
+    if IsDefined(en) { consts = en.GetConstants(); }
+    CpCheck("reflection_enum", ArraySize(consts) > 100, ToString(ArraySize(consts)));
+    CpCheck("reflection_global_function", IsDefined(Reflection.GetGlobalFunction(n"InitializeScripts;")), "");
+    let derived = Reflection.GetDerivedClasses(n"gameObject");
+    let allClasses = Reflection.GetClasses();
+    CpCheck("reflection_classes", ArraySize(allClasses) > 10000, ToString(ArraySize(allClasses)));
+    CpCheck("reflection_derived", ArraySize(derived) > 3, ToString(ArraySize(derived)));
+
+    let callbacks = GameInstance.GetCallbackSystem();
+    CpCheck("callback_system", IsDefined(callbacks), "");
+    if IsDefined(callbacks) {
+        let target = new CpAutotestCwTarget();
+        callbacks.RegisterEvent(n"CpAutotest/Ping");
+        callbacks.RegisterCallback(n"CpAutotest/Ping", target, n"OnPing");
+        callbacks.DispatchEventAs(n"CpAutotest/Ping", new CpAutotestCwEvent());
+        CpCheck("callback_dispatch", target.hits == 1, ToString(target.hits));
+    }
+
+    CpCheck("service_container", IsDefined(GameInstance.GetScriptableServiceContainer()), "");
+    let svc = GameInstance.GetScriptableServiceContainer().GetService(n"CpAutotest.CpAutotestCwService") as CpAutotestCwService;
+    CpCheck("scriptable_service_lifecycle", IsDefined(svc) && svc.loaded, IsDefined(svc) ? ToString(svc.loaded) : "null");
+}
+
+public class CpAutotestCwEvent extends CallbackSystemEvent {}
+
+public class CpAutotestCwTarget {
+    public let hits: Int32;
+    public cb func OnPing(evt: ref<CallbackSystemEvent>) {
+        this.hits += 1;
+    }
+}
+
+public class CpAutotestCwService extends ScriptableService {
+    public let loaded: Bool;
+    private cb func OnLoad() {
+        this.loaded = true;
+    }
+}
