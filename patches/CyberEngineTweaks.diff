@@ -0,0 +1,66 @@
+cmake_minimum_required(VERSION 3.24)
+project(CyberEngineTweaks VERSION 1.37.1 LANGUAGES C CXX OBJC OBJCXX ASM)
+
+# macOS arm64 build of Cyber Engine Tweaks as a RED4ext-macos plugin (red4ext/plugins/CyberEngineTweaks/).
+# The Windows build stays on xmake (xmake.lua).
+if(NOT APPLE)
+    message(FATAL_ERROR "This CMake build is for macOS; build Windows with xmake.")
+endif()
+
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_OSX_ARCHITECTURES "arm64")
+set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0")
+
+include(cmake/Dependencies.cmake)
+
+# RED4ext.SDK (macOS fork, header-only), shared with RED4ext-macos and its address DB.
+set(RED4EXT_SDK_DIR "${CMAKE_SOURCE_DIR}/../RED4ext.SDK" CACHE PATH "RED4ext.SDK (macOS) repository root")
+if(NOT EXISTS "${RED4EXT_SDK_DIR}/include/RED4ext/RED4ext.hpp")
+    message(FATAL_ERROR "RED4ext.SDK not found at ${RED4EXT_SDK_DIR}; pass -DRED4EXT_SDK_DIR=<path>.")
+endif()
+add_library(RED4ext.SDK INTERFACE)
+target_include_directories(RED4ext.SDK INTERFACE "${RED4EXT_SDK_DIR}/include")
+target_compile_definitions(RED4ext.SDK INTERFACE RED4EXT_PLATFORM_MACOS RED4EXT_HEADER_ONLY)
+
+# Version header (the Windows build generates it with xmake)
+execute_process(COMMAND git describe --tags OUTPUT_VARIABLE CET_GIT_TAG OUTPUT_STRIP_TRAILING_WHITESPACE WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
+execute_process(COMMAND git describe --tags --long OUTPUT_VARIABLE CET_GIT_TAG_LONG OUTPUT_STRIP_TRAILING_WHITESPACE WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
+execute_process(COMMAND git rev-parse --abbrev-ref HEAD OUTPUT_VARIABLE CET_GIT_BRANCH OUTPUT_STRIP_TRAILING_WHITESPACE WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
+execute_process(COMMAND git rev-parse --short HEAD OUTPUT_VARIABLE CET_GIT_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
+execute_process(COMMAND git rev-parse HEAD OUTPUT_VARIABLE CET_GIT_COMMIT_LONG OUTPUT_STRIP_TRAILING_WHITESPACE WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
+execute_process(COMMAND git log -1 --date=format:%Y%m%d%H%M%S --format=%ad OUTPUT_VARIABLE CET_GIT_COMMIT_DATE OUTPUT_STRIP_TRAILING_WHITESPACE WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}")
+set(CET_DEBUG_BUILD 0)
+set(CET_VERSION_MAJOR ${PROJECT_VERSION_MAJOR})
+set(CET_VERSION_MINOR ${PROJECT_VERSION_MINOR})
+set(CET_VERSION_PATCH ${PROJECT_VERSION_PATCH})
+set(CET_VERSION_SIMPLE "${PROJECT_VERSION}")
+set(CET_VERSION_FULL "${CET_GIT_TAG} [${CET_GIT_BRANCH}] (macOS)")
+set(CET_VERSION "${CET_VERSION_FULL}")
+string(TIMESTAMP CET_CURRENT_YEAR "%Y")
+configure_file("${CMAKE_SOURCE_DIR}/src/xmake/CETVersion.h.cmake.in" "${CMAKE_BINARY_DIR}/generated/config/CETVersion.h" @ONLY)
+
+# Sources: everything portable from src/, minus the Windows/D3D12 layers that src/macos replaces.
+file(GLOB_RECURSE CET_SOURCES CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/src/*.cpp" "${CMAKE_SOURCE_DIR}/src/*.mm" "${CMAKE_SOURCE_DIR}/src/*.c" "${CMAKE_SOURCE_DIR}/src/*.S")
+list(FILTER CET_SOURCES EXCLUDE REGEX "/src/(d3d12|window)/")
+list(FILTER CET_SOURCES EXCLUDE REGEX "/src/imgui_impl/(dx12|win32)\\.cpp$")
+list(FILTER CET_SOURCES EXCLUDE REGEX "/src/dllmain\\.cpp$")
+
+add_library(CyberEngineTweaks SHARED ${CET_SOURCES})
+set_target_properties(CyberEngineTweaks PROPERTIES OUTPUT_NAME "CyberEngineTweaks" PREFIX "" SUFFIX ".dylib")
+target_include_directories(CyberEngineTweaks PRIVATE "${CMAKE_SOURCE_DIR}/src" "${CMAKE_BINARY_DIR}/generated")
+target_compile_definitions(CyberEngineTweaks PRIVATE
+    SOL_ALL_SAFETIES_ON SOL_LUAJIT=1 SOL_EXCEPTIONS_SAFE_PROPAGATION
+    CET_PLATFORM_MACOS)
+target_precompile_headers(CyberEngineTweaks PRIVATE "$<$<COMPILE_LANGUAGE:CXX>:${CMAKE_SOURCE_DIR}/src/stdafx.h>")
+target_link_options(CyberEngineTweaks PRIVATE "-Wl,-undefined,dynamic_lookup")
+target_link_libraries(CyberEngineTweaks PRIVATE
+    RED4ext.SDK spdlog::spdlog nlohmann_json::nlohmann_json tsl::hopscotch_map tiltedcore
+    sol2_headers stb_headers sqlite3_static luajit imgui
+    "-framework Metal" "-framework QuartzCore" "-framework AppKit" "-framework GameController"
+    "-framework Carbon" "-framework CoreGraphics" "-framework Foundation")
+target_compile_options(CyberEngineTweaks PRIVATE
+    -fexceptions
+    -fvisibility=hidden -fvisibility-inlines-hidden
+    -Wno-deprecated-declarations
+    $<$<COMPILE_LANGUAGE:OBJCXX>:-fobjc-arc>)
diff --git a/cmake/Dependencies.cmake b/cmake/Dependencies.cmake
new file mode 100644
index 0000000..09c9ed4
--- /dev/null
+++ b/cmake/Dependencies.cmake
@@ -0,0 +1,122 @@
+# Third-party dependencies for the macOS build, all pinned by tag + SHA256.
+include(FetchContent)
+include(ExternalProject)
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
+
+# spdlog 1.11.0 (the version CET pins on Windows), bundled fmt, static
+set(SPDLOG_BUILD_SHARED OFF CACHE BOOL "" FORCE)
+set(SPDLOG_FMT_EXTERNAL OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(spdlog
+    URL https://github.com/gabime/spdlog/archive/refs/tags/v1.11.0.tar.gz
+    URL_HASH SHA256=ca5cae8d6cac15dae0ec63b21d6ad3530070650f68076f3a4a862ca293a858bb)
+
+set(JSON_BuildTests OFF CACHE INTERNAL "")
+FetchContent_Declare(nlohmann_json
+    URL https://github.com/nlohmann/json/archive/refs/tags/v3.11.3.tar.gz
+    URL_HASH SHA256=0d8ef5af7f9794e3263480193c491549b2ba6cc74bb018906202ada498a79406)
+
+FetchContent_Declare(hopscotch_map
+    URL https://github.com/Tessil/hopscotch-map/archive/refs/tags/v2.3.1.tar.gz
+    URL_HASH SHA256=53dab49005cd5dc859f2546d0d3eef058ec7fb3b74fc3b19f4965a9a151e9b20)
+
+# mimalloc as a plain allocator for TiltedCore: never override malloc in the game process.
+set(MI_OVERRIDE OFF CACHE BOOL "" FORCE)
+set(MI_BUILD_SHARED OFF CACHE BOOL "" FORCE)
+set(MI_BUILD_OBJECT OFF CACHE BOOL "" FORCE)
+set(MI_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(MI_OSX_INTERPOSE OFF CACHE BOOL "" FORCE)
+set(MI_OSX_ZONE OFF CACHE BOOL "" FORCE)
+FetchContent_Declare(mimalloc
+    URL https://github.com/microsoft/mimalloc/archive/refs/tags/v2.1.7.tar.gz
+    URL_HASH SHA256=0eed39319f139afde8515010ff59baf24de9e47ea316a315398e8027d198202d)
+
+# FreeType for imgui_freetype (no optional codecs)
+set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
+set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
+set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
+set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
+set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
+FetchContent_Declare(freetype
+    URL https://github.com/freetype/freetype/archive/refs/tags/VER-2-13-3.tar.gz
+    URL_HASH SHA256=bc5c898e4756d373e0d991bab053036c5eb2aa7c0d5c67e8662ddc6da40c4103)
+
+FetchContent_MakeAvailable(spdlog nlohmann_json hopscotch_map mimalloc freetype)
+# fmt 9 (bundled with spdlog 1.11) trips clang 21's consteval checks; use runtime format-string checking instead.
+target_compile_definitions(spdlog PUBLIC FMT_CONSTEVAL=)
+
+# Header-only / source-drop dependencies
+FetchContent_Declare(sol2
+    URL https://github.com/ThePhD/sol2/archive/refs/tags/v3.5.0.tar.gz
+    URL_HASH SHA256=86c0f6d2836b184a250fc2907091c076bf53c9603dd291eaebade36cc342e13c)
+FetchContent_Declare(tiltedcore
+    URL https://github.com/tiltedphoques/TiltedCore/archive/refs/tags/v0.2.7.tar.gz
+    URL_HASH SHA256=f30b9eb7b412ccb8cc5cee63abd82691f029cb6784d843f1ce9530c737f5e523)
+FetchContent_Declare(imgui
+    URL https://github.com/ocornut/imgui/archive/refs/tags/v1.91.1-docking.tar.gz
+    URL_HASH SHA256=8fdfb689edc2a485e2c772866bf1db32f68d1a313d98a76e7ebcba17c62a7ff3)
+FetchContent_Declare(sqlite3
+    URL https://www.sqlite.org/2024/sqlite-amalgamation-3460100.zip
+    URL_HASH SHA256=77823cb110929c2bcb0f5d48e4833b5c59a8a6e40cdea3936b99e199dbbe5784)
+FetchContent_Declare(stb
+    URL https://github.com/nothings/stb/archive/f58f558c120e9b32c217290b80bad1a0729fbb2c.tar.gz
+    URL_HASH SHA256=be1a5dad9ac38f42ef8abf00bd7db776101661b77603f832fcc0bae843d82846)
+FetchContent_Declare(luajit2
+    URL https://github.com/openresty/luajit2/archive/refs/tags/v2.1-20260824.tar.gz
+    URL_HASH SHA256=d73577495b63373079fe65e89613aee383db4369c22cf5b88a20a57be3d9f33a)
+foreach(dep sol2 tiltedcore imgui sqlite3 stb luajit2)
+    FetchContent_GetProperties(${dep})
+    if(NOT ${dep}_POPULATED)
+        FetchContent_Populate(${dep})
+    endif()
+endforeach()
+
+add_library(sol2_headers INTERFACE)
+target_include_directories(sol2_headers INTERFACE "${sol2_SOURCE_DIR}/include")
+
+add_library(stb_headers INTERFACE)
+target_include_directories(stb_headers INTERFACE "${stb_SOURCE_DIR}")
+
+add_library(sqlite3_static STATIC "${sqlite3_SOURCE_DIR}/sqlite3.c")
+target_include_directories(sqlite3_static PUBLIC "${sqlite3_SOURCE_DIR}")
+target_compile_definitions(sqlite3_static PRIVATE SQLITE_THREADSAFE=1)
+
+# TiltedCore expects <TiltedCore/X.hpp>; stage its headers under that prefix.
+file(GLOB TILTED_HEADERS "${tiltedcore_SOURCE_DIR}/Code/core/include/*.hpp")
+file(COPY ${TILTED_HEADERS} DESTINATION "${CMAKE_BINARY_DIR}/tiltedcore_include/TiltedCore")
+file(GLOB TILTED_SOURCES "${tiltedcore_SOURCE_DIR}/Code/core/src/*.cpp")
+add_library(tiltedcore STATIC ${TILTED_SOURCES})
+target_include_directories(tiltedcore PUBLIC "${CMAKE_BINARY_DIR}/tiltedcore_include" PRIVATE "${tiltedcore_SOURCE_DIR}/Code/core/include")
+target_compile_features(tiltedcore PUBLIC cxx_std_20)
+target_compile_definitions(tiltedcore PUBLIC NDEBUG)
+target_link_libraries(tiltedcore PUBLIC mimalloc-static tsl::hopscotch_map)
+
+# LuaJIT (OpenResty), GC64, MAP_JIT on macOS (PoC 05). Built with its own Makefile. LUA52COMPAT as on Windows
+# (xmake-repo openrestry-luajit defines it): mods rely on 5.2 syntax/library extensions (e.g. empty `;` statements).
+set(LUAJIT_SRC "${CMAKE_BINARY_DIR}/luajit-build")
+ExternalProject_Add(luajit_build
+    SOURCE_DIR "${luajit2_SOURCE_DIR}"
+    CONFIGURE_COMMAND ${CMAKE_COMMAND} -E copy_directory "${luajit2_SOURCE_DIR}" "${LUAJIT_SRC}"
+        # MAP_JIT write protection is per thread; CET runs Lua on game worker threads (see the patch).
+        COMMAND patch -p1 -N -d "${LUAJIT_SRC}" -i "${CMAKE_SOURCE_DIR}/cmake/patches/luajit-mapjit-per-thread.patch"
+    BUILD_COMMAND ${CMAKE_COMMAND} -E env MACOSX_DEPLOYMENT_TARGET=15.0
+        make -C "${LUAJIT_SRC}" -j8 "XCFLAGS=-DLUAJIT_ENABLE_GC64 -DLUAJIT_ENABLE_LUA52COMPAT -DLUAJIT_ENABLE_OSX_HRT -Wno-return-mismatch"
+    INSTALL_COMMAND ""
+    BUILD_IN_SOURCE OFF
+    BUILD_BYPRODUCTS "${LUAJIT_SRC}/src/libluajit.a")
+add_library(luajit STATIC IMPORTED GLOBAL)
+set_target_properties(luajit PROPERTIES IMPORTED_LOCATION "${LUAJIT_SRC}/src/libluajit.a")
+file(MAKE_DIRECTORY "${LUAJIT_SRC}/src")
+target_include_directories(luajit INTERFACE "${LUAJIT_SRC}/src")
+add_dependencies(luajit luajit_build)
+
+# Dear ImGui 1.91.1-docking, wchar32 + FreeType, CET's user config. The Metal/macOS backends are CET-mac's own (src/macos).
+add_library(imgui STATIC
+    "${imgui_SOURCE_DIR}/imgui.cpp" "${imgui_SOURCE_DIR}/imgui_draw.cpp" "${imgui_SOURCE_DIR}/imgui_tables.cpp"
+    "${imgui_SOURCE_DIR}/imgui_widgets.cpp" "${imgui_SOURCE_DIR}/imgui_demo.cpp"
+    "${imgui_SOURCE_DIR}/misc/freetype/imgui_freetype.cpp" "${imgui_SOURCE_DIR}/misc/cpp/imgui_stdlib.cpp")
+target_include_directories(imgui PUBLIC "${imgui_SOURCE_DIR}" "${imgui_SOURCE_DIR}/backends" "${imgui_SOURCE_DIR}/misc/cpp")
+target_compile_definitions(imgui PUBLIC IMGUI_USE_WCHAR32 IMGUI_ENABLE_FREETYPE
+    "IMGUI_USER_CONFIG=\"${CMAKE_SOURCE_DIR}/src/imgui_impl/imgui_user_config.h\"")
+target_link_libraries(imgui PUBLIC freetype)
+set(IMGUI_BACKENDS_DIR "${imgui_SOURCE_DIR}/backends")
diff --git a/cmake/patches/luajit-mapjit-per-thread.patch b/cmake/patches/luajit-mapjit-per-thread.patch
new file mode 100644
index 0000000..4ff3f4d
--- /dev/null
+++ b/cmake/patches/luajit-mapjit-per-thread.patch
@@ -0,0 +1,23 @@
+--- a/src/lj_mcode.c	2026-10-11 10:36:41
++++ b/src/lj_mcode.c	2026-10-11 10:36:41
+@@ -251,10 +251,20 @@
+ /* Change protection of MCode area. */
+ static void mcode_protect(jit_State *J, int prot)
+ {
++#if LJ_TARGET_POSIX && MCMAP_CREATE
++  /* MAP_JIT write protection is per thread, but J->mcprot is per VM. A VM
++  ** that runs on several threads (CET calls Lua overrides from game worker
++  ** threads) could skip the toggle and leave a thread writable, so its next
++  ** jump into mcode faults. Always toggle; it only flips a thread register.
++  */
++  mcode_setprot(J, J->mcarea, J->szmcarea, prot);
++  J->mcprot = prot;
++#else
+   if (J->mcprot != prot) {
+     mcode_setprot(J, J->mcarea, J->szmcarea, prot);
+     J->mcprot = prot;
+   }
++#endif
+ }
+ 
+ #endif
diff --git a/docs/MACOS_PORT.md b/docs/MACOS_PORT.md
new file mode 100644
index 0000000..50931fb
--- /dev/null
+++ b/docs/MACOS_PORT.md
@@ -0,0 +1,176 @@
+# Cyber Engine Tweaks on macOS (arm64)
+
+This branch (`macos`) builds CET 1.37.1 as a RED4ext-macos plugin for the native macOS build of Cyberpunk 2077 2.3.1
+(game binary UUID `A6656ADC-FBE2-36A4-9B9D-B4A9DE645089`). The Windows sources stay as upstream wrote them. macOS
+code is behind `#ifdef __APPLE__`, or in `src/macos/`.
+
+Evidence references:
+
+- `RE` means `research/re_cet/results.md` and `results.json` (Mac addresses and ABI for each CET hash).
+- `OC` means `research/re_cet/override_contract.md`.
+- `PoC06` means `poc/06-override-thunks`.
+
+## Build
+
+```bash
+export PATH=~/Downloads/projects/cet/tools/venv/bin:$PATH
+cmake -S . -B build-mac && cmake --build build-mac -j8 --target CyberEngineTweaks
+python3 ../RED4ext.SDK/scripts/plugin_requirements.py build-mac/CyberEngineTweaks.dylib
+```
+
+The CMake build (`CMakeLists.txt`, `cmake/Dependencies.cmake`) is for macOS only. Windows still builds with xmake.
+CMake excludes these Windows layers: `src/d3d12/`, `src/window/`, `src/imgui_impl/{dx12,win32}.cpp` and
+`src/dllmain.cpp`. These files in `src/macos/` replace them:
+
+| File | Replaces |
+| --- | --- |
+| `PluginMain.cpp` | `dllmain.cpp` (RED4ext `Main`/`Query`/`Supports`) |
+| `D3D12.h/.mm` | The renderer. It is a Metal overlay with the same class name and interface. |
+| `Window.h/.mm` | The input layer: NSEvent/GameController to `VKBindings::OnMacKey` and ImGui |
+| `MinHook.h` / `MinHookCompat.cpp` | MinHook. Calls go to RED4ext's arm64 hook engine. |
+
+## Install layout
+
+- The plugin is at `<game>/red4ext/plugins/CyberEngineTweaks/CyberEngineTweaks.dylib`.
+- CET's own folder keeps the Windows layout: `<game>/bin/x64/plugins/cyber_engine_tweaks/`. It holds `mods/`,
+  `fonts/`, `tweakdb/`, the logs, `config.json` and `bindings.json`. Nexus archives extract into it unchanged.
+- CET's "game root" keeps its Windows meaning, `<game>/bin/x64`. `<game>` is three folders above
+  `Cyberpunk2077.app/Contents/MacOS/Cyberpunk2077`.
+
+## Changes by file
+
+### Platform
+
+| File | Change | Why / evidence |
+| --- | --- | --- |
+| `src/Image.h/.cpp` | Reads the main Mach-O image's `LC_UUID`. If it is the 2.3.1 UUID, `FileVersion` = `RED4EXT_V1_RUNTIME_VERSION_2_31` (3.0.80.51928) and `SemVersion` = 2.3.1. Any other UUID gives 3.0.0.0, so the "unsupported version" path in `Options.cpp` runs. `RED4EXT_RUNTIME_LATEST` is mapped to the v1 2.31 constant. | The executable has no PE version resource. The address DB is keyed to this UUID. |
+| `src/Options.cpp` | `ExeValid` is true when the executable is named `Cyberpunk2077`. Uses the v1 runtime header. | No `GetFileVersionInfo` on macOS. CET only loads as a RED4ext plugin. |
+| `src/Paths.cpp` | Gets the executable path from `_NSGetExecutablePath`. Sets game root = 4 × `parent_path()` / `bin/x64`. | PORTING_A_PLUGIN.md §1.4 |
+| `src/Utils.h/.cpp` | On macOS, `UTF16ToUTF8(string_view)` and `UTF8ToUTF16` are identity functions on UTF-8 strings, because `path::native()` is UTF-8. `UTF16ToUTF8(wstring_view)` converts UTF-32 `wchar_t` to UTF-8. | No `WideCharToMultiByte`. |
+| `src/VKBindings.*` | The `WM_INPUT`/`HandleRAWInput` path is compiled out. | Input comes from `OnMacKey` (Window.mm). |
+| `src/macos/Win32Compat.h` (additions) | `RI_MOUSE_WHEEL`/`RI_MOUSE_HWHEEL` (same values, so saved wheel bindings stay valid), `TEXT`, `_stricmp`, `_strnicmp`, `_byteswap_*`. | MSVC CRT names used by the shared code. |
+| `src/stdafx.h` | Sets `SOL_NO_NIL 0`, because sol2 hides `sol::nil` on Apple targets and CET uses it everywhere. In `.mm` files, Win32 `BOOL` (int, also from SDK `WinCompat.hpp`) is renamed while the headers are parsed, to avoid the clash with Objective-C `BOOL`. Includes `macos/SDKCompat.h`. | Compile errors |
+| `src/macos/SDKCompat.h` | `RED4ext::ScriptInstance = void*`. | CET pins RED4ext.SDK a0776d4. The macOS fork is about 100 upstream commits newer (API v1, `rtti::IType`, aliases removed). |
+| `src/scripting/LuaSandbox.cpp` | Sandbox escape checks use `/`. Backslashes in mod paths are turned into `/`, and the absolute check runs again after that. MO2 detection is off. | Windows mods use `\\`. |
+| `src/scripting/ScriptStore.cpp` | The reserved mod name check uses the `cet` filename. | Same check without `\\`. |
+| `src/scripting/GameDump.cpp` | vtable range = main image header to the end of the last mapped segment (excluding `__LINKEDIT`). | No PE headers. |
+| `src/imgui_impl/imgui_user_config.cpp` | The assertion log converts wide strings to UTF-8. `_wassert` is Windows only. | No wide spdlog API. |
+| `src/reverse/RenderContext.*` | Windows only. | D3D12 render globals. The Metal overlay does not need them (RE: CRenderGlobal_InstanceOffset). |
+| `src/overlay/Overlay.cpp`, `src/overlay/widgets/LogWindow.cpp`, `src/reverse/LuaRED.h` | Include and `template`-keyword fixes. | clang strictness |
+| `src/macos/PluginMain.cpp`, `src/macos/Window.mm` | Lead-owned files, two compile fixes. PluginMain includes the v1 API headers and `CETVersion.h`. In Window.mm, `(BLOCKTYPE)nil` is used in the block ternary. | Compile errors |
+
+### RED4ext.SDK API drift (portable rewrites, no `#ifdef`)
+
+- `DynArray::size` and `::entries` became private. `.size` becomes `std::ranges::size(x)` and `.entries[i]` becomes
+  `x[i]`. Both forms are valid with the old SDK too. Files: `Enum.cpp`, `NativeProxy.cpp`, `RTTIHelper.cpp`,
+  `RTTIExtender.cpp`, `Type.cpp`, `TweakDB.cpp`, `TweakDBEditor.cpp`, `FunctionOverride.cpp`.
+- `FlatPool.cpp` hashes the raw array bytes. It uses `Data()`/`Size()` on macOS (same layout).
+- `NativeProxy.h/.cpp` uses the new `rtti::IType` signatures `IsEqual(const void*, const void*, uint32_t)` and
+  `Assign(void*, const void*)`. clang puts them in the same (Itanium) slots as the game.
+- `TweakDBEditor.cpp` runs without `std::execution::par_unseq`, because libc++ has no parallel algorithms without
+  `-fexperimental-library`.
+
+### Hooks and addresses (RE)
+
+| Hash | macOS address | Handling |
+| --- | --- | --- |
+| CScript_Log / LogError / LogWarning / LogChannel / LogChannelWarning | 0x1022111f8 / 0x1022112d8 / 0x1022113b8 / 0x102211498 / 0x1022116c8 | Unchanged. Native handler ABI (x0..x3) is identical. The first 4 instructions are not PC-relative. |
+| CScript_ToStringDEBUG | 0x102b79d10 | Unchanged |
+| CScript_TDBIDConstructorDerive | 0x103453b14 | New signature `uint64_t(const TweakDBID*, const char*)`. The hook registers `result`. RED4ext relocates the CBZ in its prologue. |
+| CScript_TranslateBytecode | 0x1021e897c (`CScriptDataBinder::Bind`) | The x64 LoadOpcodes is inlined. The hook is `bool(binder, data, report, bool)`, with `Initialize()` before the original call and `PostInitializeScripting()` after it. |
+| CScript_AllocateFunction | 0x10217844c (`PoolStorageProxy<PoolRTTIFunction>::Allocate`) | `Block{ptr,size}(uint64 size)`. It returns `real(max(size, 0xC0))`. |
+| CScript_RunPureScript | 0x102172bf4 | Unchanged. The `isNative` branch is still needed (OC path 3). |
+| CScript_TweakDBLoad | 0x102b75570 | Unchanged. `TweakDB::unk160` is still at +0x160 (SDK assert). |
+| PlayerSystem_OnPlayerSpawned | 0x103fd4d70 | Unchanged (4 integer arguments) |
+| C{BaseInitialization,Initialization,Running,Shutdown}State_OnTick | 0x103d8c0cc / 0x103d8d710 / 0x103d8d820 / 0x103d8d94c | Kept as inline hooks on the functions the game-state vtables' OnUpdate slots point to. RED4ext's state hooks call these originals every tick. ADRP is relocated by the hook engine. The RED4ext `GameStates` API was not used, because a plugin `OnUpdate` returning false blocks the Init/Shutdown transitions and returning true unregisters it. That does not fit CET's per-tick queues. `IGameState::GetType` (slot +0x18 with two dtor slots) is clang-correct in the SDK. |
+| CPatches_Vignette | 0x100b388d4 (VignettePlayData IsValid) | Patched to `mov w0,#0; ret` |
+| CPatches_BoundaryTeleport | 0x103d69c44 | Patched to `ret` |
+| CPatches_OptionsInit | not used on macOS | See "Hidden options" |
+| CRenderNode_Present_DoInternal, CRenderGlobal_Resize/Shutdown/InstanceOffset, InputSystemWin32Base_ForceCursor | not used | Replaced by the Metal overlay (present swizzle) and the input layer. |
+| gameIGameSystem_* / CPhotoMode_SetRecordID / SpawnCallback | not used | exEntitySpawner is not built (see below). |
+
+All CET hashes the macOS build uses are in `research/re_cet/cet_address_overlay.json`, ready to merge into the
+address DB. Until a hash is verified there, it resolves to 0. `MH_CreateHook` then fails closed and CET logs that the
+hook is missing.
+
+**Code patches** (`src/macos/MacPlatform.cpp`, `CETMac::PatchCode`): `mach_vm_protect(R|W|VM_PROT_COPY)`, then
+`memcpy`, then `mach_vm_protect(R|X)`, then `sys_icache_invalidate`. This works on the stock signed binary on this
+machine. The patch is applied once at load. It is not reverted.
+
+**Hidden options** (`src/patches/OptionsPatch.cpp`, `src/scripting/GameOptions.h`):
+
+- `Config::IConfigVar::Register` runs only from static initializers, before RED4ext loads CET (RE), so a hook never
+  fires.
+- Instead, CET walks `src/macos/ConfigVars.inc`. That file holds 1339 `CConfigVar` objects with a proven bool, int or
+  float type. It is generated from the 2.3.1 binary by `scripts/macos/gen_config_vars.py` from
+  `RED4ext.SDK/scripts/config_var_dump.py` output.
+- Each object is accepted only when its name (+0x8) and group (+0x10) strings match.
+- On macOS the value block is at +0x2C (not +0x30). String and color variables are not exposed.
+- The AsyncCompute and Antialiasing patches target D3D12 settings and do nothing on Metal.
+
+**Oodle** (`LuaVM_Hooks.cpp`, `ResourcesList.cpp`, `CETMac::GetOodleDecompress`): the macOS game links Oodle
+statically and exports nothing.
+
+- `tweakdb/tweakdb.str` (uncompressed) works as on Windows.
+- `tweakdbstr.kark` and `usedhashes.kark` can only be read if `OodleLZ_Decompress` is available. That needs a
+  `liboo2core*.dylib` in CET's folder, or one that is already loaded.
+- Otherwise CET logs an error, TweakDBID names stay unresolved (hex), and resource paths show as unresolved in the
+  TweakDB editor.
+- Packaging tip: decompress `tweakdbstr.kark` to `tweakdb.str` once, on any machine.
+
+### Observe / Override (OC, PoC06)
+
+- `src/scripting/FunctionOverrideThunks.S` holds 8192 thunks of 32 bytes each in the dylib's own `__TEXT`. There is no
+  JIT, no `MAP_JIT` and no RWX memory.
+- Thunk *i* loads `x4 = g_cetOverrideThunkCtx[i].real` and `x16 = .dispatch`, then runs `br x16`. x0–x3, sp, fp and lr
+  are untouched.
+- `FunctionOverride::AllocateThunk` binds the next free thunk. Thunks are never reused, the same as the Windows RWX
+  buffer. One thunk is used per overridden function. When all 8192 are in use, the override is refused and logged.
+- Member handlers are registered by `CClassFunction::Create`, which on macOS passes the PTMF `{thunk, 0}`.
+- `Override()` refuses to run when the allocation hook is not active. Without it, the 0xC0-byte swap would overflow a
+  0xB8-byte `CScriptedFunction`.
+- `CMakeLists.txt` now enables the `ASM` language. Without it, CMake globbed the `.S` file but never assembled it.
+
+### Scripting
+
+- `src/scripting/Texture.*`: images are decoded with stb_image (RGBA8) and uploaded with
+  `D3D12::CreateTextureRGBA8`. The texture is released in `Release()` or the destructor.
+- `src/reverse/RTTIExtender.cpp`:
+  - **exEntitySpawner is not built on macOS.** Its spawn callback (`world::RuntimeEntityRegistry::RegisterEntity`) was
+    not found, and Spawn/SpawnSettings differ (x8 sret, settings -0x20) (RE). Codeware's DynamicEntitySystem
+    replaces it.
+  - `WorldFunctionalTests.SpawnEntity` still spawns, but returns an empty `entEntityID`. On macOS
+    `FunctionalTestsGameSystem` is 0x130 bytes and the pending-entity layout is unverified.
+  - `WorldFunctionalTests.unk40` at +0x40 matches the macOS RTTI size (0x50).
+
+## Layout audit
+
+- `scripts/sdk_layout_diff.py --plugin-sources src`: 0 of the gated SDK classes differ.
+- CET's own mirrors of game types:
+  - `GameOption`: fixed, see "Hidden options".
+  - `TEMP_*` spawner structs: not built.
+  - `WorldFunctionalTests`: matches.
+  - `CStackFrame`, `CStack` and `CScriptStack`: SDK asserts match OC.
+  - `IStack` virtuals `GetResultAddr`/`GetResultType`: at +0x10/+0x18 under clang, which matches OC.
+- No CET code indexes a game vtable directly.
+- The NativeProxy bytecode stub (CallStatic/ParamEnd opcodes, 8-byte pointers) is format-identical.
+
+## What users will notice on macOS
+
+- exEntitySpawner (legacy CET spawner) is missing. `WorldFunctionalTests.SpawnEntity` returns an empty ID.
+- TweakDBID names and resource paths only resolve with an uncompressed `tweakdb.str`, or with an Oodle dylib for the
+  `.kark` files.
+- Hidden options: only bool, int and float config variables are listed or settable. The DX12-only patches do nothing.
+- `Override`/`Observe` is limited to 8192 distinct functions per session.
+
+## Open risks
+
+- 14 CET hashes need the overlay applied and verified in the DB. Two of them are "likely" in RE:
+  `CScript_TranslateBytecode` (Bind) and `CScript_AllocateFunction`. `PlayerSystem_OnPlayerSpawned` and
+  `CPatches_Vignette` are also "likely". Check all four with a logging run.
+- Log, LogChannel and ToStringDEBUG handlers are 4 instructions before the first call. The inline hook relies on
+  RED4ext relocating exactly 16 bytes.
+- The Bind hook assumes one call per script load, the same as TranslateBytecode on Windows.
+- The FreeType and LuaJIT symbols exported by the dylib (from the dependencies) could clash with other plugins' copies.
+  Two-level namespaces normally prevent that.
+- Nothing has been run in game yet.
diff --git a/scripts/macos/gen_config_vars.py b/scripts/macos/gen_config_vars.py
new file mode 100644
index 0000000..8060eea
--- /dev/null
+++ b/scripts/macos/gen_config_vars.py
@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+"""Generate src/macos/ConfigVars.inc from RED4ext.SDK's config_var_dump.py JSON (game 2.3.1, UUID A6656ADC-...).
+
+    python3 ../RED4ext.SDK/scripts/config_var_dump.py --binary <Cyberpunk2077> --json cv.json
+    python3 scripts/macos/gen_config_vars.py cv.json > src/macos/ConfigVars.inc
+
+Only variables whose value type is proven (bool/int/float vtables, value at +0x2C) are emitted. CET checks each object's
+name (+0x8) and group (+0x10) strings at runtime before using it (src/patches/OptionsPatch.cpp).
+"""
+import json
+import sys
+
+BASE = 0x100000000
+vars_ = [v for v in json.load(open(sys.argv[1])) if v.get("verified") and v.get("type") in ("bool", "int", "float")]
+vars_.sort(key=lambda v: int(v["address"], 16))
+print("// Generated by scripts/macos/gen_config_vars.py from config_var_dump.py (game 2.3.1, UUID A6656ADC-FBE2-36A4-9B9D-B4A9DE645089).")
+print(f"// {len(vars_)} CConfigVar objects with a proven bool/int/float type: {{offset from image base, group, name}}.")
+for v in vars_:
+    off = int(v["address"], 16) - BASE
+    print(f'{{0x{off:x}, "{v["group"]}", "{v["name"]}"}},')
