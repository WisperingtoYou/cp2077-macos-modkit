+// macOS: Config::IConfigVar::Register (CPatches_OptionsInit, 0x101e35408) only runs from the game's static
+// initializers, before RED4ext loads CET, so a hook would never fire (research/re_cet/results.md). Instead walk the
+// known CConfigVar objects (generated from the 2.3.1 binary, src/macos/ConfigVars.inc), keep the ones whose name and
+// group pointers match, and run the same per-option logic as HookGameOptionInit (without calling an original).
+void OptionsInitHook()
+{
+    const mach_header_64* header = nullptr;
+    for (uint32_t i = 0; i < _dyld_image_count(); ++i)
+    {
+        const auto* candidate = reinterpret_cast<const mach_header_64*>(_dyld_get_image_header(i));
+        if (candidate->filetype == MH_EXECUTE)
+        {
+            header = candidate;
+            break;
+        }
+    }
+
+    if (!header || !CET::Get().GetOptions().ExeValid)
+    {
+        Log::Warn("Hidden options: failed (game image not found)");
+        return;
+    }
+
+    auto& gameOptions = GameOptions::GetList();
+    auto& options = CET::Get().GetOptions();
+    const auto base = reinterpret_cast<uintptr_t>(header);
+    size_t mismatched = 0;
+
+    for (const auto& var : s_configVars)
+    {
+        auto* pOption = reinterpret_cast<GameOption*>(base + var.offset);
+        if (!pOption->pName || !pOption->pCategory || std::strcmp(pOption->pName, var.name) != 0 || std::strcmp(pOption->pCategory, var.group) != 0)
+        {
+            ++mismatched;
+            continue;
+        }
+
+        if (std::ranges::find(gameOptions, pOption) == gameOptions.end())
+            gameOptions.emplace_back(pOption);
+
+        if (options.Developer.DumpGameOptions)
+            Log::Info(pOption->GetInfo());
+        // The AsyncCompute / Antialiasing patches target D3D12 settings that do not exist in the Metal renderer.
+    }
+
+    if (mismatched)
+        Log::Warn("Hidden options: {} of {} known config variables did not match and were skipped", mismatched, std::size(s_configVars));
+    Log::Info("Hidden options: {} config variables available", gameOptions.size());
+}
