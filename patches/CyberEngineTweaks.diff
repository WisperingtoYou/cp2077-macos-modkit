diff --git a/src/scripting/FunctionOverrideThunks.S b/src/scripting/FunctionOverrideThunks.S
new file mode 100644
index 0000000..dc9912d
--- /dev/null
+++ b/src/scripting/FunctionOverrideThunks.S
@@ -0,0 +1,28 @@
+// macOS arm64: pool of pre-assembled override thunks, replacing the x64 code that FunctionOverride.cpp generates with
+// xbyak into RWX memory on Windows. The code is part of the signed dylib's __TEXT, so no JIT/MAP_JIT is needed.
+//
+// Thunk i (32 bytes, at _cet_override_thunks + 32*i):
+//     x4  = g_cetOverrideThunkCtx[i].real      (the CClassFunction*, 5th arg of HandleOverridenFunction)
+//     x16 = g_cetOverrideThunkCtx[i].dispatch  (FunctionOverride::HandleOverridenFunction)
+//     br x16                                   (tail call: x0-x3, sp, fp and lr untouched)
+// Contract: research/re_cet/override_contract.md; proven in poc/06-override-thunks.
+#define CET_OVERRIDE_THUNK_COUNT 8192
+
+    .section __TEXT,__text,regular,pure_instructions
+    .p2align 5
+    .private_extern _cet_override_thunks
+_cet_override_thunks:
+    .set i, 0
+    .rept CET_OVERRIDE_THUNK_COUNT
+    adrp x16, _g_cetOverrideThunkCtx@PAGE
+    add  x16, x16, _g_cetOverrideThunkCtx@PAGEOFF
+    movz x17, #i
+    add  x16, x16, x17, lsl #4
+    ldr  x4, [x16]
+    ldr  x16, [x16, #8]
+    br   x16
+    brk  #0
+    .set i, i + 1
+    .endr
+    .private_extern _cet_override_thunks_end
+_cet_override_thunks_end:
