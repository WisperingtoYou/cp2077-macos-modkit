diff --git a/src/macos/MacPlatform.cpp b/src/macos/MacPlatform.cpp
new file mode 100644
index 0000000..3932540
--- /dev/null
+++ b/src/macos/MacPlatform.cpp
@@ -0,0 +1,152 @@
+#include <stdafx.h>
+
+#include "macos/MacPlatform.h"
+
+#include <dlfcn.h>
+#include <mach-o/dyld.h>
+#include <mach-o/getsect.h>
+
+#include <algorithm>
+#include <memory>
+#include <libkern/OSCacheControl.h>
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+
+#include <CET.h>
+
+namespace CETMac
+{
+namespace
+{
+using TRealOodleLZ_Decompress = intptr_t (*)(const void* compBuf, intptr_t compBufSize, void* rawBuf, intptr_t rawLen, int fuzzSafe, int checkCRC,
+                                             int verbosity, void* decBufBase, intptr_t decBufSize, void* fpCallback, void* callbackUserData,
+                                             void* decoderMemory, intptr_t decoderMemorySize, int threadPhase);
+
+TRealOodleLZ_Decompress s_realDecompress{nullptr};
+
+// Prologue of OodleLZ_Decompress in the 2.3.1 binary (file 0x10009ECA4); unique in __TEXT,__text.
+constexpr uint8_t kOodleDecompressPrologue[] = {
+    0xfc, 0x6f, 0xba, 0xa9, 0xfa, 0x67, 0x01, 0xa9, 0xf8, 0x5f, 0x02, 0xa9, 0xf6, 0x57, 0x03, 0xa9, 0xf4, 0x4f, 0x04, 0xa9, 0xfd, 0x7b,
+    0x05, 0xa9, 0xfd, 0x43, 0x01, 0x91, 0xff, 0x43, 0x01, 0xd1, 0xfa, 0x03, 0x07, 0xaa, 0xf3, 0x03, 0x06, 0xaa, 0xf4, 0x03, 0x05, 0xaa,
+    0xf8, 0x03, 0x04, 0xaa, 0xf9, 0x03, 0x03, 0xaa, 0xfc, 0x03, 0x02, 0xaa, 0xf7, 0x03, 0x01, 0xaa, 0xfb, 0x03, 0x00, 0xaa};
+
+TRealOodleLZ_Decompress FindGameOodleDecompress()
+{
+    // The game executable. Not image 0: with DYLD_INSERT_LIBRARIES, the inserted RED4ext.dylib comes first.
+    const mach_header_64* header = nullptr;
+    const char* imageName = "?";
+    for (uint32_t i = 0, count = _dyld_image_count(); i < count && !header; ++i)
+    {
+        const auto* candidate = reinterpret_cast<const mach_header_64*>(_dyld_get_image_header(i));
+        if (candidate && candidate->filetype == MH_EXECUTE)
+        {
+            header = candidate;
+            imageName = _dyld_get_image_name(i);
+        }
+    }
+    if (!header)
+        return nullptr;
+    unsigned long size = 0;
+    const auto* text = getsectiondata(header, "__TEXT", "__text", &size);
+    if (!text || size < sizeof(kOodleDecompressPrologue))
+    {
+        Log::Warn("Oodle lookup: no __TEXT,__text in {}", imageName);
+        return nullptr;
+    }
+
+    const auto* end = text + size;
+    const auto* hit = std::search(text, end, std::begin(kOodleDecompressPrologue), std::end(kOodleDecompressPrologue));
+    if (hit == end)
+    {
+        Log::Warn("Oodle lookup: prologue not found in {} (__text {} bytes at {})", imageName, size, static_cast<const void*>(text));
+        return nullptr;
+    }
+    // Must be the only match: a second one means a different build, and guessing would call the wrong function.
+    if (std::search(hit + 4, end, std::begin(kOodleDecompressPrologue), std::end(kOodleDecompressPrologue)) != end)
+    {
+        Log::Warn("Oodle lookup: prologue matches more than once; not guessing");
+        return nullptr;
+    }
+    return reinterpret_cast<TRealOodleLZ_Decompress>(const_cast<uint8_t*>(hit));
+}
+
+size_t OodleDecompressShim(char* in, int insz, char* out, int outsz, int wantsFuzzSafety, int b, int c, void*, void*, void*, void*, void*, size_t, int)
+{
+    constexpr intptr_t kDecoderMemorySize = 0x80000; // what the game passes; Kraken needs at most 0x6D0D8
+    thread_local std::unique_ptr<uint8_t[]> decoderMemory(new uint8_t[kDecoderMemorySize]);
+    const auto result = s_realDecompress(in, insz, out, outsz, wantsFuzzSafety, b, c, nullptr, 0, nullptr, nullptr, decoderMemory.get(),
+                                         kDecoderMemorySize, 3);
+    return result > 0 ? static_cast<size_t>(result) : 0;
+}
+} // namespace
+
+TOodleLZ_Decompress GetOodleDecompress()
+{
+    static TOodleLZ_Decompress s_decompress = []() -> TOodleLZ_Decompress
+    {
+        // Already loaded by someone else (e.g. another mod)?
+        if (auto* sym = dlsym(RTLD_DEFAULT, "OodleLZ_Decompress"))
+        {
+            s_realDecompress = reinterpret_cast<TRealOodleLZ_Decompress>(sym);
+            return &OodleDecompressShim;
+        }
+
+        std::error_code ec;
+        const auto& root = CET::Get().GetPaths().CETRoot();
+        for (const auto& entry : std::filesystem::directory_iterator(root, ec))
+        {
+            const auto name = entry.path().filename().string();
+            if (!name.starts_with("liboo2core") || entry.path().extension() != ".dylib")
+                continue;
+            if (void* handle = dlopen(entry.path().c_str(), RTLD_NOW | RTLD_LOCAL))
+            {
+                if (auto* sym = dlsym(handle, "OodleLZ_Decompress"))
+                {
+                    Log::Info("Using {} for Oodle decompression", name);
+                    s_realDecompress = reinterpret_cast<TRealOodleLZ_Decompress>(sym);
+                    return &OodleDecompressShim;
+                }
+                dlclose(handle);
+            }
+        }
+
+        if ((s_realDecompress = FindGameOodleDecompress()))
+        {
+            Log::Info("Using the game's OodleLZ_Decompress at {}", reinterpret_cast<void*>(s_realDecompress));
+            return &OodleDecompressShim;
+        }
+        return nullptr;
+    }();
+    return s_decompress;
+}
+
+bool PatchCode(void* apAddress, const void* apBytes, size_t aSize)
+{
+    if (!apAddress || !apBytes || !aSize)
+        return false;
+
+    const auto task = mach_task_self();
+    const auto pageSize = static_cast<mach_vm_address_t>(vm_page_size);
+    const auto address = reinterpret_cast<mach_vm_address_t>(apAddress);
+    const auto pageStart = address & ~(pageSize - 1);
+    const auto pageEnd = (address + aSize + pageSize - 1) & ~(pageSize - 1);
+    const auto length = static_cast<mach_vm_size_t>(pageEnd - pageStart);
+
+    // The game's __TEXT is mapped R-X from a signed file; VM_PROT_COPY gives this process a private writable copy.
+    auto kr = mach_vm_protect(task, pageStart, length, FALSE, VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY);
+    if (kr != KERN_SUCCESS)
+    {
+        Log::Error("PatchCode: mach_vm_protect(RW|COPY) at {:#x} failed: {}", address, mach_error_string(kr));
+        return false;
+    }
+
+    std::memcpy(apAddress, apBytes, aSize);
+
+    kr = mach_vm_protect(task, pageStart, length, FALSE, VM_PROT_READ | VM_PROT_EXECUTE);
+    if (kr != KERN_SUCCESS)
+        Log::Error("PatchCode: restoring R|X at {:#x} failed: {}", address, mach_error_string(kr));
+
+    sys_icache_invalidate(apAddress, aSize);
+    return kr == KERN_SUCCESS;
+}
+} // namespace CETMac
