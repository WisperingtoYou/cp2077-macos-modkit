diff --git a/src/macos/Window.h b/src/macos/Window.h
new file mode 100644
index 0000000..9d65ac0
--- /dev/null
+++ b/src/macos/Window.h
@@ -0,0 +1,67 @@
+#pragma once
+
+// macOS: input layer replacing the Win32 window subclass (src/window/Window.h).
+//
+// - -[NSApplication sendEvent:] is swizzled: every key/mouse event is translated (macOS keycode -> Windows VK, so
+//   CET bindings stay compatible with Windows configs), handed to VKBindings and queued for ImGui.
+// - While the overlay traps input, the game must not see it. The game reads input through three paths, all gated:
+//   1. NSEvents reaching sendEvent:          -> swallowed by the swizzle,
+//   2. its NSEvent local monitor(s)           -> handler blocks wrapped at registration (+addLocalMonitor... swizzle),
+//   3. GameController GCMouse/GCKeyboard/pad  -> value/pressed/moved handler blocks wrapped at registration.
+// - ImGui gets a virtual cursor driven by mouse deltas (the game disassociates the OS cursor), drawn by ImGui.
+
+#include "macos/Win32Compat.h"
+
+#include <mutex>
+#include <string>
+#include <vector>
+
+struct D3D12;
+struct VKBindings;
+struct ImGuiIO;
+
+struct Window
+{
+    Window(VKBindings* apBindings, D3D12* apD3D12);
+    ~Window();
+
+    HWND GetWindow() const { return nullptr; }
+    bool IsInitialized() const { return m_initialized; }
+
+    // Game-thread side: drains queued input into ImGui (called by D3D12::PrepareUpdate under the ImGui lock).
+    void FeedImGui(ImGuiIO& aIO, SIZE aDrawableSize, bool aTrapped);
+
+    // Overlay open/closed: frees/captures the cursor and gates game input.
+    void SetCursorFree(bool aFree);
+
+    // Called from the swizzles (main thread).
+    bool OnNSEvent(void* apEvent);
+
+private:
+    struct InputEvent
+    {
+        enum class Type
+        {
+            Key,
+            Char,
+            MouseDelta,
+            MouseButton,
+            Wheel,
+            FocusLost
+        } type;
+        int key{0};     // ImGuiKey for Key
+        bool down{false};
+        float x{0}, y{0};
+        std::string text;
+    };
+
+    void Push(InputEvent&& aEvent);
+
+    bool m_initialized{false};
+    VKBindings* m_pBindings;
+    D3D12* m_pD3D12;
+
+    std::mutex m_queueLock;
+    std::vector<InputEvent> m_queue;
+    float m_cursorX{-1}, m_cursorY{-1};
+};
