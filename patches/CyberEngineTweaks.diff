+
+#include "macos/KeyCodeToImGuiKey.inl"
+
+// macOS virtual keycode -> Windows virtual-key code (CET bindings are stored as VK codes).
+USHORT KeyCodeToVK(unsigned short aKeyCode)
+{
+    switch (aKeyCode)
+    {
+    case kVK_ANSI_A: return 'A'; case kVK_ANSI_B: return 'B'; case kVK_ANSI_C: return 'C'; case kVK_ANSI_D: return 'D';
+    case kVK_ANSI_E: return 'E'; case kVK_ANSI_F: return 'F'; case kVK_ANSI_G: return 'G'; case kVK_ANSI_H: return 'H';
+    case kVK_ANSI_I: return 'I'; case kVK_ANSI_J: return 'J'; case kVK_ANSI_K: return 'K'; case kVK_ANSI_L: return 'L';
+    case kVK_ANSI_M: return 'M'; case kVK_ANSI_N: return 'N'; case kVK_ANSI_O: return 'O'; case kVK_ANSI_P: return 'P';
+    case kVK_ANSI_Q: return 'Q'; case kVK_ANSI_R: return 'R'; case kVK_ANSI_S: return 'S'; case kVK_ANSI_T: return 'T';
+    case kVK_ANSI_U: return 'U'; case kVK_ANSI_V: return 'V'; case kVK_ANSI_W: return 'W'; case kVK_ANSI_X: return 'X';
+    case kVK_ANSI_Y: return 'Y'; case kVK_ANSI_Z: return 'Z';
+    case kVK_ANSI_0: return '0'; case kVK_ANSI_1: return '1'; case kVK_ANSI_2: return '2'; case kVK_ANSI_3: return '3';
+    case kVK_ANSI_4: return '4'; case kVK_ANSI_5: return '5'; case kVK_ANSI_6: return '6'; case kVK_ANSI_7: return '7';
+    case kVK_ANSI_8: return '8'; case kVK_ANSI_9: return '9';
+    case kVK_ANSI_Keypad0: return VK_NUMPAD0; case kVK_ANSI_Keypad1: return VK_NUMPAD1; case kVK_ANSI_Keypad2: return VK_NUMPAD2;
+    case kVK_ANSI_Keypad3: return VK_NUMPAD3; case kVK_ANSI_Keypad4: return VK_NUMPAD4; case kVK_ANSI_Keypad5: return VK_NUMPAD5;
+    case kVK_ANSI_Keypad6: return VK_NUMPAD6; case kVK_ANSI_Keypad7: return VK_NUMPAD7; case kVK_ANSI_Keypad8: return VK_NUMPAD8;
+    case kVK_ANSI_Keypad9: return VK_NUMPAD9;
+    case kVK_ANSI_KeypadMultiply: return VK_MULTIPLY; case kVK_ANSI_KeypadPlus: return VK_ADD;
+    case kVK_ANSI_KeypadMinus: return VK_SUBTRACT; case kVK_ANSI_KeypadDecimal: return VK_DECIMAL;
+    case kVK_ANSI_KeypadDivide: return VK_DIVIDE; case kVK_ANSI_KeypadEnter: return VK_RETURN;
+    case kVK_ANSI_KeypadClear: return VK_NUMLOCK; case kVK_ANSI_KeypadEquals: return VK_OEM_PLUS;
+    case kVK_F1: return VK_F1; case kVK_F2: return VK_F2; case kVK_F3: return VK_F3; case kVK_F4: return VK_F4;
+    case kVK_F5: return VK_F5; case kVK_F6: return VK_F6; case kVK_F7: return VK_F7; case kVK_F8: return VK_F8;
+    case kVK_F9: return VK_F9; case kVK_F10: return VK_F10; case kVK_F11: return VK_F11; case kVK_F12: return VK_F12;
+    case kVK_F13: return VK_F13; case kVK_F14: return VK_F14; case kVK_F15: return VK_F15; case kVK_F16: return VK_F16;
+    case kVK_F17: return VK_F17; case kVK_F18: return VK_F18; case kVK_F19: return VK_F19; case kVK_F20: return VK_F20;
+    case kVK_Return: return VK_RETURN; case kVK_Tab: return VK_TAB; case kVK_Space: return VK_SPACE;
+    case kVK_Delete: return VK_BACK; case kVK_ForwardDelete: return VK_DELETE; case kVK_Escape: return VK_ESCAPE;
+    case kVK_Home: return VK_HOME; case kVK_End: return VK_END; case kVK_PageUp: return VK_PRIOR;
+    case kVK_PageDown: return VK_NEXT; case kVK_Help: return VK_INSERT;
+    case kVK_LeftArrow: return VK_LEFT; case kVK_RightArrow: return VK_RIGHT; case kVK_UpArrow: return VK_UP;
+    case kVK_DownArrow: return VK_DOWN;
+    case kVK_Shift: return VK_LSHIFT; case kVK_RightShift: return VK_RSHIFT;
+    case kVK_Control: return VK_LCONTROL; case kVK_RightControl: return VK_RCONTROL;
+    case kVK_Option: return VK_LMENU; case kVK_RightOption: return VK_RMENU;
+    case kVK_Command: return VK_LWIN; case kVK_RightCommand: return VK_RWIN;
+    case kVK_CapsLock: return VK_CAPITAL;
+    case kVK_ANSI_Semicolon: return VK_OEM_1; case kVK_ANSI_Equal: return VK_OEM_PLUS; case kVK_ANSI_Comma: return VK_OEM_COMMA;
+    case kVK_ANSI_Minus: return VK_OEM_MINUS; case kVK_ANSI_Period: return VK_OEM_PERIOD; case kVK_ANSI_Slash: return VK_OEM_2;
+    case kVK_ANSI_Grave: return VK_OEM_3; case kVK_ANSI_LeftBracket: return VK_OEM_4; case kVK_ANSI_Backslash: return VK_OEM_5;
+    case kVK_ANSI_RightBracket: return VK_OEM_6; case kVK_ANSI_Quote: return VK_OEM_7; case kVK_ISO_Section: return VK_OEM_102;
+    default: return 0;
+    }
+}
+
+bool IsInputEvent(NSEventType aType)
+{
+    switch (aType)
+    {
+    case NSEventTypeKeyDown: case NSEventTypeKeyUp: case NSEventTypeFlagsChanged:
+    case NSEventTypeLeftMouseDown: case NSEventTypeLeftMouseUp: case NSEventTypeRightMouseDown: case NSEventTypeRightMouseUp:
+    case NSEventTypeOtherMouseDown: case NSEventTypeOtherMouseUp: case NSEventTypeMouseMoved:
+    case NSEventTypeLeftMouseDragged: case NSEventTypeRightMouseDragged: case NSEventTypeOtherMouseDragged:
+    case NSEventTypeScrollWheel:
+        return true;
+    default:
+        return false;
+    }
+}
+
+// A release must reach the game even while the overlay is open, or the game keeps that key held until it loses focus.
+bool IsReleaseEvent(NSEventType aType)
+{
+    switch (aType)
+    {
+    case NSEventTypeKeyUp: case NSEventTypeFlagsChanged:
+    case NSEventTypeLeftMouseUp: case NSEventTypeRightMouseUp: case NSEventTypeOtherMouseUp:
+        return true;
+    default:
+        return false;
+    }
+}
+
+// ---- swizzles ---------------------------------------------------------------------------------------------------
+IMP s_origSendEvent = nullptr;
+void HookSendEvent(id aSelf, SEL aSel, NSEvent* aEvent)
+{
+    if (s_window && s_window->OnNSEvent((__bridge void*)aEvent))
+        return; // swallowed: the overlay owns input
+    reinterpret_cast<void (*)(id, SEL, NSEvent*)>(s_origSendEvent)(aSelf, aSel, aEvent);
+}
+
+// The game's local monitors run before sendEvent:. While trapped they must not see input; the event is passed on
+// unchanged so sendEvent: (and the overlay) still receive it.
+IMP s_origAddLocalMonitor = nullptr;
+id HookAddLocalMonitor(id aSelf, SEL aSel, NSEventMask aMask, NSEvent* _Nullable (^aHandler)(NSEvent*))
+{
+    NSEvent* _Nullable (^original)(NSEvent*) = [aHandler copy];
+    NSEvent* _Nullable (^wrapped)(NSEvent*) = ^NSEvent* _Nullable(NSEvent* event) {
+        if (s_trapped && IsInputEvent(event.type))
+        {
+            if (IsReleaseEvent(event.type))
+                original(event);
+            return event; // always: the overlay still needs this event in sendEvent:
+        }
+        return original(event);
+    };
+    return reinterpret_cast<id (*)(id, SEL, NSEventMask, id)>(s_origAddLocalMonitor)(aSelf, aSel, aMask, wrapped);
+}
+
+// GameController handlers (raw mouse deltas, keyboard, gamepad): drop callbacks while trapped.
+template<typename Block>
+struct GcSetterHook
+{
+    static inline std::mutex s_lock;
+    static inline std::unordered_map<std::string, IMP> s_original;
+};
+
+#define CET_GC_HOOK(NAME, BLOCKTYPE, CALLARGS, PARAMS, ALLOW)                                                       \
+    IMP s_orig_##NAME = nullptr;                                                                                   \
+    void Hook_##NAME(id aSelf, SEL aSel, BLOCKTYPE aHandler)                                                       \
+    {                                                                                                              \
+        BLOCKTYPE original = [aHandler copy];                                                                      \
+        BLOCKTYPE wrapped = original ? ^PARAMS {                                                                   \
+            if (!s_trapped || (ALLOW))                                                                             \
+                original CALLARGS;                                                                                 \
+        } : (BLOCKTYPE)nil;                                                                                       \
+        reinterpret_cast<void (*)(id, SEL, BLOCKTYPE)>(s_orig_##NAME)(aSelf, aSel, wrapped);                       \
+    }
+
+CET_GC_HOOK(MouseMoved, GCMouseMoved, (mouse, dx, dy), (GCMouseInput* mouse, float dx, float dy), false)
+CET_GC_HOOK(ButtonValue, GCControllerButtonValueChangedHandler, (button, value, pressed),
+            (GCControllerButtonInput* button, float value, BOOL pressed), !pressed)
+CET_GC_HOOK(ButtonPressed, GCControllerButtonValueChangedHandler, (button, value, pressed),
+            (GCControllerButtonInput* button, float value, BOOL pressed), !pressed)
+CET_GC_HOOK(AxisValue, GCControllerAxisValueChangedHandler, (axis, value), (GCControllerAxisInput* axis, float value), false)
+CET_GC_HOOK(DpadValue, GCControllerDirectionPadValueChangedHandler, (dpad, x, y),
+            (GCControllerDirectionPad* dpad, float x, float y), false)
+CET_GC_HOOK(KeyChanged, GCKeyboardValueChangedHandler, (keyboard, key, keyCode, pressed),
+            (GCKeyboardInput* keyboard, GCControllerButtonInput* key, GCKeyCode keyCode, BOOL pressed), !pressed)
+
+void Swizzle(Class aClass, SEL aSel, IMP aHook, IMP* apOriginal, bool aClassMethod = false)
+{
+    Method m = aClassMethod ? class_getClassMethod(aClass, aSel) : class_getInstanceMethod(aClass, aSel);
+    if (!m)
+    {
+        Log::Warn("Window (macOS): {}[{} {}] not found", aClassMethod ? "+" : "-", class_getName(aClass), sel_getName(aSel));
+        return;
+    }
+    *apOriginal = method_setImplementation(m, aHook);
+}
+
+void InstallSwizzles()
+{
+    static std::once_flag once;
+    std::call_once(once, [] {
+        Swizzle([NSApplication class], @selector(sendEvent:), reinterpret_cast<IMP>(HookSendEvent), &s_origSendEvent);
+        Swizzle([NSEvent class], @selector(addLocalMonitorForEventsMatchingMask:handler:),
+                reinterpret_cast<IMP>(HookAddLocalMonitor), &s_origAddLocalMonitor, true);
+        Swizzle([GCMouseInput class], @selector(setMouseMovedHandler:), reinterpret_cast<IMP>(Hook_MouseMoved), &s_orig_MouseMoved);
+        Swizzle([GCControllerButtonInput class], @selector(setValueChangedHandler:), reinterpret_cast<IMP>(Hook_ButtonValue),
+                &s_orig_ButtonValue);
+        Swizzle([GCControllerButtonInput class], @selector(setPressedChangedHandler:), reinterpret_cast<IMP>(Hook_ButtonPressed),
+                &s_orig_ButtonPressed);
+        Swizzle([GCControllerAxisInput class], @selector(setValueChangedHandler:), reinterpret_cast<IMP>(Hook_AxisValue),
+                &s_orig_AxisValue);
+        Swizzle([GCControllerDirectionPad class], @selector(setValueChangedHandler:), reinterpret_cast<IMP>(Hook_DpadValue),
+                &s_orig_DpadValue);
+        Swizzle([GCKeyboardInput class], @selector(setKeyChangedHandler:), reinterpret_cast<IMP>(Hook_KeyChanged),
+                &s_orig_KeyChanged);
+    });
+}
+
+void PushModifierKeys(Window& aWindow, NSEventModifierFlags aFlags);
+}
+
+UINT MapVirtualKey(UINT aCode, UINT aMapType)
+{
+    if (aMapType != MAPVK_VK_TO_CHAR)
+        return 0;
+    if ((aCode >= 'A' && aCode <= 'Z') || (aCode >= '0' && aCode <= '9'))
+        return aCode;
+    switch (aCode)
+    {
+    case VK_SPACE: return ' ';
+    case VK_OEM_1: return ';'; case VK_OEM_PLUS: return '='; case VK_OEM_COMMA: return ',';
+    case VK_OEM_MINUS: return '-'; case VK_OEM_PERIOD: return '.'; case VK_OEM_2: return '/';
+    case VK_OEM_3: return '`'; case VK_OEM_4: return '['; case VK_OEM_5: return '\\';
+    case VK_OEM_6: return ']'; case VK_OEM_7: return '\'';
+    default: return 0;
+    }
+}
+
+Window::Window(VKBindings* apBindings, D3D12* apD3D12)
+    : m_pBindings(apBindings)
+    , m_pD3D12(apD3D12)
+{
+    s_window = this;
+    if ([NSThread isMainThread])
+        InstallSwizzles();
+    else
+        dispatch_sync(dispatch_get_main_queue(), ^{ InstallSwizzles(); });
+    m_initialized = true;
+}
+
+Window::~Window()
+{
+    s_window = nullptr;
+}
+
+void Window::Push(InputEvent&& aEvent)
+{
+    std::lock_guard lock(m_queueLock);
+    if (m_queue.size() < 4096)
+        m_queue.emplace_back(std::move(aEvent));
+}
+
+bool Window::OnNSEvent(void* apEvent)
+{
+    NSEvent* event = (__bridge NSEvent*)apEvent;
+    const NSEventType type = event.type;
+    const bool trapped = s_trapped;
+
+    switch (type)
+    {
+    case NSEventTypeKeyDown:
+    case NSEventTypeKeyUp:
+    {
+        const bool down = type == NSEventTypeKeyDown;
+        const auto vk = KeyCodeToVK(event.keyCode);
+        if (vk && m_pBindings && !(down && event.isARepeat))
+            m_pBindings->OnMacKey(vk, down);
+        Push({InputEvent::Type::Key, static_cast<int>(ImGui_ImplOSX_KeyCodeToImGuiKey(event.keyCode)), down});
+        const bool command = event.modifierFlags & NSEventModifierFlagCommand;
+        if (down && command) // AppKit sends no key-up for a key pressed with Cmd held, so V would stay down
+            Push({InputEvent::Type::Key, static_cast<int>(ImGui_ImplOSX_KeyCodeToImGuiKey(event.keyCode)), false});
+        if (down && trapped)
+        {
+            NSString* chars = event.characters;
+            if (chars.length > 0 && !(event.modifierFlags & NSEventModifierFlagCommand))
+            {
+                const unichar c = [chars characterAtIndex:0];
+                if (c >= 0x20 && c != 0x7F && (c < 0xF700 || c > 0xF8FF)) // skip control and function-key chars
+                    Push({InputEvent::Type::Char, 0, false, 0, 0, std::string([chars UTF8String] ?: "")});
+            }
+        }
+        // Cmd+Q / Cmd+Tab etc. always reach the system; everything else is the overlay's while trapped.
+        const bool textChord = event.keyCode == kVK_ANSI_V || event.keyCode == kVK_ANSI_C || event.keyCode == kVK_ANSI_X ||
+                               event.keyCode == kVK_ANSI_A || event.keyCode == kVK_ANSI_Z;
+        return down && trapped && (!command || textChord);
+    }
+    case NSEventTypeFlagsChanged:
+    {
+        const auto vk = KeyCodeToVK(event.keyCode);
+        const auto flags = event.modifierFlags;
+        bool down = false;
+        switch (event.keyCode)
+        {
+        case kVK_Shift: case kVK_RightShift: down = flags & NSEventModifierFlagShift; break;
+        case kVK_Control: case kVK_RightControl: down = flags & NSEventModifierFlagControl; break;
+        case kVK_Option: case kVK_RightOption: down = flags & NSEventModifierFlagOption; break;
+        case kVK_Command: case kVK_RightCommand: down = flags & NSEventModifierFlagCommand; break;
+        case kVK_CapsLock: down = flags & NSEventModifierFlagCapsLock; break;
+        default: break;
+        }
+        if (vk && m_pBindings)
+            m_pBindings->OnMacKey(vk, down);
+        Push({InputEvent::Type::Key, static_cast<int>(ImGui_ImplOSX_KeyCodeToImGuiKey(event.keyCode)), down});
+        return false; // modifiers always pass through (the game tracks them too)
+    }
+    case NSEventTypeLeftMouseDown: case NSEventTypeLeftMouseUp:
+    case NSEventTypeRightMouseDown: case NSEventTypeRightMouseUp:
+    case NSEventTypeOtherMouseDown: case NSEventTypeOtherMouseUp:
+    {
+        const bool down = type == NSEventTypeLeftMouseDown || type == NSEventTypeRightMouseDown || type == NSEventTypeOtherMouseDown;
+        const int button = static_cast<int>(event.buttonNumber);
+        static const USHORT buttonVK[] = {VK_LBUTTON, VK_RBUTTON, VK_MBUTTON, VK_XBUTTON1, VK_XBUTTON2};
+        if (button < 5 && m_pBindings)
+            m_pBindings->OnMacKey(buttonVK[button], down);
+        Push({InputEvent::Type::MouseButton, button, down});
+        return down && trapped;
+    }
+    case NSEventTypeMouseMoved: case NSEventTypeLeftMouseDragged:
+    case NSEventTypeRightMouseDragged: case NSEventTypeOtherMouseDragged:
+    {
+        const CGFloat scale = event.window ? event.window.backingScaleFactor : 2.0;
+        Push({InputEvent::Type::MouseDelta, 0, false, static_cast<float>(event.deltaX * scale), static_cast<float>(event.deltaY * scale)});
+        return trapped;
+    }
+    case NSEventTypeScrollWheel:
+    {
+        float dx = event.scrollingDeltaX, dy = event.scrollingDeltaY;
+        if (event.hasPreciseScrollingDeltas)
+            dx *= 0.1f, dy *= 0.1f;
+        Push({InputEvent::Type::Wheel, 0, false, dx, dy});
+        return trapped;
+    }
+    case NSEventTypeAppKitDefined:
+        if (event.subtype == NSEventSubtypeApplicationDeactivated)
+        {
+            if (m_pBindings)
+                m_pBindings->OnMacFocusLost();
+            Push({InputEvent::Type::FocusLost});
+        }
+        return false;
+    default:
+        return false;
+    }
+}
+
+void Window::FeedImGui(ImGuiIO& aIO, SIZE aDrawableSize, bool aTrapped)
+{
+    std::vector<InputEvent> events;
+    {
+        std::lock_guard lock(m_queueLock);
+        events.swap(m_queue);
+    }
+
+    if (m_cursorX < 0)
+        m_cursorX = aDrawableSize.cx * 0.5f, m_cursorY = aDrawableSize.cy * 0.5f;
+
+    aIO.MouseDrawCursor = aTrapped; // the OS cursor stays the game's; ImGui draws its own while the overlay is open
+
+    // Modifier state as ImGui expects it (key chords such as Ctrl+C in text fields). Fed first so Cmd+V is seen as a chord.
+    const NSEventModifierFlags flags = [NSEvent modifierFlags];
+    aIO.AddKeyEvent(ImGuiMod_Ctrl, (flags & NSEventModifierFlagCommand) || (flags & NSEventModifierFlagControl));
+    aIO.AddKeyEvent(ImGuiMod_Shift, flags & NSEventModifierFlagShift);
+    aIO.AddKeyEvent(ImGuiMod_Alt, flags & NSEventModifierFlagOption);
+    aIO.AddKeyEvent(ImGuiMod_Super, false);
+
+    for (auto& e : events)
+    {
+        switch (e.type)
+        {
+        case InputEvent::Type::Key:
+            if (e.key != ImGuiKey_None)
+                aIO.AddKeyEvent(static_cast<ImGuiKey>(e.key), e.down);
+            break;
+        case InputEvent::Type::Char:
+            aIO.AddInputCharactersUTF8(e.text.c_str());
+            break;
+        case InputEvent::Type::MouseDelta:
+            if (aTrapped)
+            {
+                m_cursorX = std::clamp(m_cursorX + e.x, 0.0f, static_cast<float>(aDrawableSize.cx - 1));
+                m_cursorY = std::clamp(m_cursorY + e.y, 0.0f, static_cast<float>(aDrawableSize.cy - 1));
+                aIO.AddMousePosEvent(m_cursorX, m_cursorY);
+            }
+            break;
+        case InputEvent::Type::MouseButton:
+            if (aTrapped && e.key < ImGuiMouseButton_COUNT)
+                aIO.AddMouseButtonEvent(e.key, e.down);
+            break;
+        case InputEvent::Type::Wheel:
+            if (aTrapped)
+                aIO.AddMouseWheelEvent(e.x, e.y);
+            break;
+        case InputEvent::Type::FocusLost:
+            aIO.AddFocusEvent(false);
+            aIO.AddFocusEvent(true);
+            break;
+        }
+    }
+}
+
+void Window::SetCursorFree(bool aFree)
+{
+    s_trapped = aFree;
+    if (aFree)
+    {
+        std::lock_guard lock(m_queueLock);
+        m_queue.clear();
+    }
+}
