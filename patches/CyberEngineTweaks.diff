index 0000000..b094754
--- /dev/null
+++ b/src/macos/D3D12.h
@@ -0,0 +1,77 @@
+#pragma once
+
+// macOS: Metal implementation of CET's renderer. It keeps the name and public interface of the Windows D3D12 class
+// (src/d3d12/D3D12.h) so CET.cpp, Scripting and the overlay need no changes; only the platform layer differs.
+//
+// Threading model (same as Windows):
+// - the game's main-thread task (GameMainThread) runs PrepareUpdate(): drains queued input, builds the ImGui frame
+//   (overlay + Lua mods) and copies the draw data into a staging buffer;
+// - the render thread runs Update() from the presentDrawable: swizzle: it encodes the newest staged draw data into the
+//   game's own command buffer right before the original present (PoC 04).
+
+#include <TiltedCore/Signal.hpp>
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <vector>
+
+#include "macos/Win32Compat.h"
+
+struct Window;
+struct Paths;
+struct Options;
+
+struct D3D12
+{
+    D3D12(Window& aWindow, Paths& aPaths, Options& aOptions);
+    ~D3D12();
+
+    void ReloadFonts();
+
+    void SetTrapInputInImGui(const bool acEnabled);
+    void DelayedSetTrapInputInImGui(const bool acEnabled);
+    [[nodiscard]] bool IsTrapInputInImGui() const noexcept { return m_trapInputInImGui; }
+    [[nodiscard]] bool IsInitialized() const noexcept { return m_initialized; }
+    [[nodiscard]] SIZE GetResolution() const noexcept { return m_outSize; }
+
+    TiltedPhoques::Signal<void()> OnInitialized;
+
+    // Lua image API (scripting/Texture.cpp): uploads RGBA8 pixels, returns an ImTextureID (id<MTLTexture>, retained).
+    void* CreateTextureRGBA8(const uint8_t* apPixels, int aWidth, int aHeight);
+    void ReleaseTexture(void* apTexture);
+
+    // Called by the present swizzle (src/macos/MetalHooks.mm) on the render thread.
+    void OnPresent(void* apCommandBuffer, void* apDrawable);
+
+    // Output transfer for the overlay: 0 auto (from the drawable), else forced mode; paper white in nits for PQ.
+    void SetHdrPaperWhite(float aNits) noexcept { m_paperWhiteNits = aNits; }
+
+protected:
+    bool Initialize(void* apDevice, void* apDrawable);
+    void PrepareUpdate();
+    void Update(void* apCommandBuffer, void* apDrawable);
+    void UpdateOutputTransfer(void* apDrawable);
+
+private:
+    bool m_initialized{false};
+    SIZE m_outSize{};
+    std::atomic_bool m_trapInputInImGui{false};
+    std::atomic_bool m_delayedTrapInput{false};
+    std::atomic_bool m_delayedTrapInputState{false};
+    float m_paperWhiteNits{203.0f};
+
+    ImGuiStyle m_styleReference{};
+    Paths& m_paths;
+    Window& m_window;
+    Options& m_options;
+
+    std::recursive_mutex m_imguiLock;
+    std::array<ImDrawData, 3> m_imguiDrawDataBuffers;
+    void* m_device{nullptr}; // id<MTLDevice>, retained
+    // Textures replaced while staged draw data may still reference them (font atlas rebuilds); released a few
+    // presents later, on the render thread.
+    std::vector<std::pair<void*, uint64_t>> m_retiredTextures;
+    uint64_t m_presentCount{0};
+};
diff --git a/src/macos/D3D12.mm b/src/macos/D3D12.mm
new file mode 100644
index 0000000..d99c0be
--- /dev/null
+++ b/src/macos/D3D12.mm
@@ -0,0 +1,580 @@
+#include <stdafx.h>
+
+#include "macos/D3D12.h"
+#include "macos/Window.h"
+#include "macos/imgui_impl_metal_cet.h"
+
+#include "CET.h"
+
+#import <AppKit/AppKit.h>
+#import <Foundation/Foundation.h>
+#import <Metal/Metal.h>
+#import <QuartzCore/QuartzCore.h>
+#include <objc/runtime.h>
+
+#include <chrono>
+#include <map>
+
+
+namespace
+{
+D3D12* s_renderer = nullptr;
+
+// presentDrawable: swizzle (PoC 04). Three selector variants exist; originals are kept per concrete class so other
+// swizzlers (Steam overlay, Metal HUD) stay chained. Only the outermost call on a thread draws.
+std::mutex s_swizzleMutex;
+std::map<Class, IMP> s_original[3];
+thread_local int t_presentDepth = 0;
+
+// Hooks share one IMP per selector across classes, so a nested [super presentDrawable:] lands in the same hook. Each
+// nesting level continues the class walk where the previous level stopped, which calls each original exactly once.
+thread_local Class t_resolved[16];
+
+IMP OriginalFor(int aVariant, id aSelf, int aDepth)
+{
+    std::lock_guard lock(s_swizzleMutex);
+    Class start = aDepth == 0 ? object_getClass(aSelf) : class_getSuperclass(t_resolved[aDepth - 1]);
+    for (Class c = start; c; c = class_getSuperclass(c))
+    {
+        auto it = s_original[aVariant].find(c);
+        if (it != s_original[aVariant].end())
+        {
+            t_resolved[aDepth] = c;
+            return it->second;
+        }
+    }
+    t_resolved[aDepth] = nil;
+    return nullptr;
+}
+
+void Present(id aSelf, id aDrawable)
+{
+    if (t_presentDepth == 1 && s_renderer && [aDrawable conformsToProtocol:@protocol(CAMetalDrawable)])
+        s_renderer->OnPresent((__bridge void*)aSelf, (__bridge void*)aDrawable);
+}
+
+template<int Variant, typename... Args>
+void CallOriginal(id aSelf, SEL aSel, id aDrawable, Args... aArgs)
+{
+    const int depth = t_presentDepth++;
+    if (depth >= 15)
+    {
+        --t_presentDepth;
+        return;
+    }
+    Present(aSelf, aDrawable);
+    auto original = reinterpret_cast<void (*)(id, SEL, id, Args...)>(OriginalFor(Variant, aSelf, depth));
+    if (original)
+        original(aSelf, aSel, aDrawable, aArgs...);
+    --t_presentDepth;
+}
+
+void HookPresent0(id aSelf, SEL aSel, id aDrawable)
+{
+    CallOriginal<0>(aSelf, aSel, aDrawable);
+}
+
+void HookPresent1(id aSelf, SEL aSel, id aDrawable, CFTimeInterval aTime)
+{
+    CallOriginal<1>(aSelf, aSel, aDrawable, aTime);
+}
+
+void HookPresent2(id aSelf, SEL aSel, id aDrawable, CFTimeInterval aDuration)
+{
+    CallOriginal<2>(aSelf, aSel, aDrawable, aDuration);
+}
+
+void SwizzleClass(Class aClass)
+{
+    static const SEL selectors[3] = {@selector(presentDrawable:), @selector(presentDrawable:atTime:),
+                                     @selector(presentDrawable:afterMinimumDuration:)};
+    static const IMP hooks[3] = {reinterpret_cast<IMP>(HookPresent0), reinterpret_cast<IMP>(HookPresent1),
+                                 reinterpret_cast<IMP>(HookPresent2)};
+    std::lock_guard lock(s_swizzleMutex);
+    for (int i = 0; i < 3; ++i)
+    {
+        // Only methods the class itself defines; inherited ones are hooked on the class that defines them.
+        unsigned count = 0;
+        Method* methods = class_copyMethodList(aClass, &count);
+        for (unsigned m = 0; m < count; ++m)
+        {
+            if (method_getName(methods[m]) != selectors[i])
+                continue;
+            IMP previous = method_setImplementation(methods[m], hooks[i]);
+            if (previous != hooks[i])
+            {
+                s_original[i][aClass] = previous;
+                Log::Info("D3D12 (Metal): hooked -[{} {}]", class_getName(aClass), sel_getName(selectors[i]));
+            }
+        }
+        free(methods);
+    }
+}
+
+void ScanCommandBufferClasses()
+{
+    // Hook every loaded class whose own method list defines a present selector: _MTLCommandBuffer (the implementation
+    // AGXG17XFamilyCommandBuffer inherits on M5), plus the Metal tools/debug wrappers. No protocol filter: Metal's
+    // private classes do not reliably report MTLCommandBuffer conformance. SwizzleClass is idempotent, and
+    // class_copyMethodList does not run +initialize.
+    unsigned count = 0;
+    Class* classes = objc_copyClassList(&count);
+    for (unsigned i = 0; i < count; ++i)
+    {
+        unsigned methodCount = 0;
+        Method* methods = class_copyMethodList(classes[i], &methodCount);
+        bool hasPresent = false;
+        for (unsigned m = 0; m < methodCount && !hasPresent; ++m)
+        {
+            const SEL sel = method_getName(methods[m]);
+            hasPresent = sel == @selector(presentDrawable:) || sel == @selector(presentDrawable:atTime:) ||
+                         sel == @selector(presentDrawable:afterMinimumDuration:);
+        }
+        free(methods);
+        if (hasPresent)
+            SwizzleClass(classes[i]);
+    }
+    free(classes);
+}
+
+void InstallPresentHooks()
+{
+    @autoreleasepool
+    {
+        // Force the driver's command buffer class to load, then scan.
+        id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        id<MTLCommandBuffer> buffer = [queue commandBuffer];
+        (void)buffer;
+        ScanCommandBufferClasses();
+    }
+    for (double delay : {2.0, 6.0, 15.0})
+    {
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, static_cast<int64_t>(delay * NSEC_PER_SEC)),
+                       dispatch_get_global_queue(QOS_CLASS_DEFAULT, 0), ^{
+                           @autoreleasepool
+                           {
+                               // Command buffer classes that load late (other queues, the driver's replay path).
+                               ScanCommandBufferClasses();
+                           }
+                       });
+    }
+}
+
+int TransferModeFor(id<CAMetalDrawable> aDrawable)
+{
+    CAMetalLayer* layer = aDrawable.layer;
+    CGColorSpaceRef space = layer.colorspace;
+    if (!space)
+        return 0;
+    if (CGColorSpaceUsesITUR_2100TF(space))
+    {
+        CFStringRef name = CGColorSpaceCopyName(space);
+        const bool pq = name && (CFStringCompare(name, kCGColorSpaceITUR_2100_PQ, 0) == kCFCompareEqualTo ||
+                                 CFStringCompare(name, kCGColorSpaceDisplayP3_PQ, 0) == kCFCompareEqualTo);
+        if (name)
+            CFRelease(name);
+        if (pq)
+            return 2;
+    }
+    if (CGColorSpaceUsesExtendedRange(space) && layer.wantsExtendedDynamicRangeContent)
+        return 1;
+    return 0;
+}
+}
+
+D3D12::D3D12(Window& aWindow, Paths& aPaths, Options& aOptions)
+    : m_paths(aPaths)
+    , m_window(aWindow)
+    , m_options(aOptions)
+{
+    s_renderer = this;
+    InstallPresentHooks();
+
+    GameMainThread::Get().AddGenericTask(
+        [this]
+        {
+            PrepareUpdate();
+            return false;
+        });
+}
+
+D3D12::~D3D12()
+{
+    s_renderer = nullptr;
+    if (m_device)
+        CFRelease(m_device);
+}
+
+void D3D12::SetTrapInputInImGui(const bool acEnabled)
+{
+    m_trapInputInImGui = acEnabled;
+    m_window.SetCursorFree(acEnabled);
+}
+
+void D3D12::DelayedSetTrapInputInImGui(const bool acEnabled)
+{
+    m_delayedTrapInputState = acEnabled;
+    m_delayedTrapInput = true;
+}
+
+bool D3D12::Initialize(void* apDevice, void* apDrawable)
+{
+    std::lock_guard _(m_imguiLock);
+
+    id<CAMetalDrawable> drawable = (__bridge id<CAMetalDrawable>)apDrawable;
+    m_device = (void*)CFBridgingRetain((__bridge id<MTLDevice>)apDevice);
+    m_outSize = {static_cast<LONG>(drawable.texture.width), static_cast<LONG>(drawable.texture.height)};
+
+    const auto [resx, resy] = m_outSize;
+    const auto scaleFromReference = std::min(static_cast<float>(resx) / 1920.0f, static_cast<float>(resy) / 1080.0f);
+
+    if (ImGui::GetCurrentContext() == nullptr)
+    {
+        IMGUI_CHECKVERSION();
+        ImGui::CreateContext();
+
+        ImGui::StyleColorsDark(&m_styleReference);
+        m_styleReference.WindowRounding = 6.0f;
+        m_styleReference.WindowTitleAlign.x = 0.5f;
+        m_styleReference.ChildRounding = 6.0f;
+        m_styleReference.PopupRounding = 6.0f;
+        m_styleReference.FrameRounding = 6.0f;
+        m_styleReference.ScrollbarRounding = 12.0f;
+        m_styleReference.GrabRounding = 12.0f;
+        m_styleReference.TabRounding = 6.0f;
+    }
+
+    ImGui::GetStyle() = m_styleReference;
+    ImGui::GetStyle().ScaleAllSizes(scaleFromReference);
+
+    auto& io = ImGui::GetIO();
+    io.ConfigFlags |= ImGuiConfigFlags_NoMouseCursorChange;
+    io.ConfigMacOSXBehaviors = false; // Window.mm already maps Cmd to Ctrl; ImGui's own swap would cancel it
+    auto& platformIO = ImGui::GetPlatformIO();
+    platformIO.Platform_GetClipboardTextFn = [](ImGuiContext*) -> const char* {
+        static std::string s_text;
+        @autoreleasepool
+        {
+            NSString* text = [[NSPasteboard generalPasteboard] stringForType:NSPasteboardTypeString];
+            s_text = text ? std::string([text UTF8String] ?: "") : std::string();
+        }
+        return s_text.c_str();
+    };
+    platformIO.Platform_SetClipboardTextFn = [](ImGuiContext*, const char* aText) {
+        @autoreleasepool
+        {
+            NSPasteboard* pasteboard = [NSPasteboard generalPasteboard];
+            [pasteboard clearContents];
+            [pasteboard setString:[NSString stringWithUTF8String:aText] ?: @"" forType:NSPasteboardTypeString];
+        }
+    };
+    io.BackendPlatformName = "cet_macos";
+    io.DisplaySize = ImVec2(static_cast<float>(resx), static_cast<float>(resy));
+    io.DisplayFramebufferScale = ImVec2(1.0f, 1.0f);
+
+    if (!ImGui_ImplMetal_Init((__bridge id<MTLDevice>)apDevice))
+    {
+        Log::Error("D3D12 (Metal)::Initialize() - ImGui_ImplMetal_Init failed!");
+        return false;
+    }
+
+    ReloadFonts();
+
+    m_initialized = true;
+    Log::Info("D3D12 (Metal) initialized: {}x{}, pixel format {}, transfer mode {}", resx, resy,
+              static_cast<int>(drawable.texture.pixelFormat), TransferModeFor(drawable));
+
+    spdlog::default_logger()->flush();
+    OnInitialized.Emit();
+    return true;
+}
+
+void D3D12::ReloadFonts()
+{
+    std::lock_guard _(m_imguiLock);
+
+    const auto [resx, resy] = m_outSize;
+    const auto scaleFromReference = std::min(static_cast<float>(resx) / 1920.0f, static_cast<float>(resy) / 1080.0f);
+
+    auto& io = ImGui::GetIO();
+    io.Fonts->Clear();
+
+    ImFontConfig config;
+    const auto& fontSettings = m_options.Font;
+    config.SizePixels = std::floor(fontSettings.BaseSize * scaleFromReference);
+    config.OversampleH = fontSettings.OversampleHorizontal;
+    config.OversampleV = fontSettings.OversampleVertical;
+    if (config.OversampleH == 1 && config.OversampleV == 1)
+        config.PixelSnapH = true;
+    config.MergeMode = false;
+
+    const auto fontsDir = m_paths.Fonts();
+    auto pathIfExists = [&](const std::filesystem::path& aPath) -> std::string
+    {
+        std::error_code ec;
+        const auto full = aPath.is_absolute() ? aPath : fontsDir / aPath;
+        return std::filesystem::exists(full, ec) ? full.string() : std::string{};
+    };
+
+    std::string mainFont = fontSettings.Path.empty() ? std::string{} : pathIfExists(std::filesystem::path(fontSettings.Path));
+    if (mainFont.empty())
+    {
+        if (!fontSettings.Path.empty())
+            Log::Warn("D3D12::ReloadFonts() - Custom font path is invalid! Using default CET font.");
+        mainFont = pathIfExists("NotoSans-Regular.ttf");
+    }
+    const auto* glyphRanges = io.Fonts->GetGlyphRangesDefault();
+    if (mainFont.empty())
+    {
+        Log::Warn("D3D12::ReloadFonts() - Missing default fonts!");
+        io.Fonts->AddFontDefault(&config);
+    }
+    else
+        io.Fonts->AddFontFromFileTTF(mainFont.c_str(), config.SizePixels, &config, glyphRanges);
+
+    // Extra language font, chosen by the setting or else by the macOS preferred language.
+    std::string language = fontSettings.Language;
+    if (language.empty() || language == "Default")
+    {
+        @autoreleasepool
+        {
+            NSString* preferred = NSLocale.preferredLanguages.firstObject ?: @"en";
+            if ([preferred hasPrefix:@"zh-Hant"])
+                language = "ChineseFull";
+            else if ([preferred hasPrefix:@"zh"])
+                language = "ChineseSimplifiedCommon";
+            else if ([preferred hasPrefix:@"ja"])
+                language = "Japanese";
+            else if ([preferred hasPrefix:@"ko"])
+                language = "Korean";
+            else if ([preferred hasPrefix:@"ru"] || [preferred hasPrefix:@"uk"])
+                language = "Cyrillic";
+            else if ([preferred hasPrefix:@"th"])
+                language = "Thai";
+            else if ([preferred hasPrefix:@"vi"])
+                language = "Vietnamese";
+        }
+    }
+    std::string extraFont;
+    const ImWchar* extraRanges = nullptr;
+    if (language == "ChineseFull")
+        extraFont = pathIfExists("NotoSansTC-Regular.otf"), extraRanges = io.Fonts->GetGlyphRangesChineseFull();
+    else if (language == "ChineseSimplifiedCommon")
+        extraFont = pathIfExists("NotoSansSC-Regular.otf"), extraRanges = io.Fonts->GetGlyphRangesChineseSimplifiedCommon();
+    else if (language == "Japanese")
+        extraFont = pathIfExists("NotoSansJP-Regular.otf"), extraRanges = io.Fonts->GetGlyphRangesJapanese();
+    else if (language == "Korean")
+        extraFont = pathIfExists("NotoSansKR-Regular.otf"), extraRanges = io.Fonts->GetGlyphRangesKorean();
+    else if (language == "Cyrillic")
+        extraFont = pathIfExists("NotoSans-Regular.ttf"), extraRanges = io.Fonts->GetGlyphRangesCyrillic();
+    else if (language == "Thai")
+        extraFont = pathIfExists("NotoSansThai-Regular.ttf"), extraRanges = io.Fonts->GetGlyphRangesThai();
+    else if (language == "Vietnamese")
+        extraFont = pathIfExists("NotoSans-Regular.ttf"), extraRanges = io.Fonts->GetGlyphRangesVietnamese();
+    if (!extraFont.empty() && extraRanges)
+    {
+        config.MergeMode = true;
+        io.Fonts->AddFontFromFileTTF(extraFont.c_str(), config.SizePixels, &config, extraRanges);
+    }
+
+    // Material Design icons, merged into the main font (same as Windows).
+    const auto iconFont = pathIfExists("materialdesignicons.ttf");
+    if (!iconFont.empty())
+    {
+        static const ImWchar iconRanges[] = {ICON_MIN_MD, ICON_MAX_MD, 0};
+        ImFontConfig iconConfig = config;
+        iconConfig.MergeMode = true;
+        iconConfig.GlyphMinAdvanceX = config.SizePixels;
+        io.Fonts->AddFontFromFileTTF(iconFont.c_str(), config.SizePixels, &iconConfig, iconRanges);
+    }
+
+    io.Fonts->Build();
+    if (m_device)
+    {
+        // Keep the previous atlas alive: draw data staged before this rebuild still references it.
+        if (void* oldTexture = reinterpret_cast<void*>(io.Fonts->TexID))
+            m_retiredTextures.emplace_back(const_cast<void*>(CFBridgingRetain((__bridge id)oldTexture)), m_presentCount);
+        ImGui_ImplMetal_DestroyFontsTexture();
+        ImGui_ImplMetal_CreateFontsTexture((__bridge id<MTLDevice>)m_device);
+    }
+}
+
+void D3D12::PrepareUpdate()
+{
+    if (!m_initialized)
+        return;
+
+    std::lock_guard _(m_imguiLock);
+
+    if (m_delayedTrapInput)
+    {
+        SetTrapInputInImGui(m_delayedTrapInputState);
+        m_delayedTrapInput = false;
+    }
+
+    static auto s_last = std::chrono::steady_clock::now();
+    const auto now = std::chrono::steady_clock::now();
+    auto& io = ImGui::GetIO();
+    io.DeltaTime = std::max(std::chrono::duration<float>(now - s_last).count(), 1.0f / 1000.0f);
+    s_last = now;
+    io.DisplaySize = ImVec2(static_cast<float>(m_outSize.cx), static_cast<float>(m_outSize.cy));
+
+    m_window.FeedImGui(io, m_outSize, m_trapInputInImGui);
+
+    ImGui::NewFrame();
+
+    CET::Get().GetOverlay().Update();
+    CET::Get().GetVM().Draw();
+
+    ImGui::Render();
+
+    auto& drawData = m_imguiDrawDataBuffers[2];
+    for (auto i = 0; i < drawData.CmdListsCount; ++i)
+        IM_DELETE(drawData.CmdLists[i]);
+    drawData.Clear();
+
+    drawData = *ImGui::GetDrawData();
+    ImVector<ImDrawList*> copiedDrawLists;
+    copiedDrawLists.resize(drawData.CmdListsCount);
+    for (auto i = 0; i < drawData.CmdListsCount; ++i)
+        copiedDrawLists[i] = drawData.CmdLists[i]->CloneOutput();
+    drawData.CmdLists = std::move(copiedDrawLists);
+
+    std::swap(m_imguiDrawDataBuffers[1], m_imguiDrawDataBuffers[2]);
+}
+
+void D3D12::OnPresent(void* apCommandBuffer, void* apDrawable)
+{
+    id<MTLCommandBuffer> commandBuffer = (__bridge id<MTLCommandBuffer>)apCommandBuffer;
+    id<CAMetalDrawable> drawable = (__bridge id<CAMetalDrawable>)apDrawable;
+
+    if (!m_initialized)
+    {
+        if (!Initialize((__bridge void*)commandBuffer.device, apDrawable))
+            return;
+    }
+
+    const LONG width = static_cast<LONG>(drawable.texture.width);
+    const LONG height = static_cast<LONG>(drawable.texture.height);
+    if (width != m_outSize.cx || height != m_outSize.cy)
+    {
+        std::lock_guard _(m_imguiLock);
+        m_outSize = {width, height};
+        Log::Info("D3D12 (Metal): drawable resized to {}x{}", width, height);
+    }
+
+    Update(apCommandBuffer, apDrawable);
+}
+
+void D3D12::UpdateOutputTransfer(void* apDrawable)
+{
+    id<CAMetalDrawable> drawable = (__bridge id<CAMetalDrawable>)apDrawable;
+    int mode = TransferModeFor(drawable);
+    if (const char* forced = std::getenv("CET_MAC_TRANSFER"))
+        mode = std::atoi(forced); // diagnostics / user override: 0 SDR, 1 EDR, 2 PQ
+    ImGui_ImplMetal_SetOutputTransfer(mode, mode == 2 ? m_paperWhiteNits : (mode == 1 ? m_paperWhiteNits / 203.0f : 1.0f));
+}
+
+void D3D12::Update(void* apCommandBuffer, void* apDrawable)
+{
+    id<MTLCommandBuffer> commandBuffer = (__bridge id<MTLCommandBuffer>)apCommandBuffer;
+    id<CAMetalDrawable> drawable = (__bridge id<CAMetalDrawable>)apDrawable;
+    id<MTLTexture> target = drawable.texture;
+
+    // Nothing to draw: skip the render pass entirely (a full-frame load/store pass is not free at 4K).
+    {
+        std::lock_guard _(m_imguiLock);
+        if (m_imguiDrawDataBuffers[1].Valid)
+        {
+            std::swap(m_imguiDrawDataBuffers[0], m_imguiDrawDataBuffers[1]);
+            m_imguiDrawDataBuffers[1].Valid = false;
+        }
+        if (!m_imguiDrawDataBuffers[0].Valid || m_imguiDrawDataBuffers[0].TotalVtxCount == 0)
+            return;
+    }
+
+    if (target.framebufferOnly && !(target.usage & MTLTextureUsageRenderTarget))
+        return;
+
+    MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = target;
+    pass.colorAttachments[0].loadAction = MTLLoadActionLoad;
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+
+    std::lock_guard _(m_imguiLock);
+    ++m_presentCount;
+    // Release retired textures once every in-flight frame that could reference them has been presented.
+    std::erase_if(m_retiredTextures, [this](const auto& aEntry) {
+        if (m_presentCount - aEntry.second < 8)
+            return false;
+        CFRelease(aEntry.first);
+        return true;
+    });
+    UpdateOutputTransfer(apDrawable);
+    ImGui_ImplMetal_NewFrame(pass);
+    id<MTLRenderCommandEncoder> encoder = [commandBuffer renderCommandEncoderWithDescriptor:pass];
+    [encoder pushDebugGroup:@"CET overlay"];
+    ImGui_ImplMetal_RenderDrawData(&m_imguiDrawDataBuffers[0], commandBuffer, encoder);
+    [encoder popDebugGroup];
+    [encoder endEncoding];
+
+    // Diagnostics: CET_MAC_READBACK=1 writes the first frame that contains CET UI to <cet>/readback.raw (RGBA16F or
+    // the drawable's format, tightly packed) plus a .txt with width/height/format. CET_MAC_READBACK=overlay waits until
+    // the overlay has been open for 60 presents instead.
+    static std::atomic_bool s_readbackDone{false};
+    static uint64_t s_overlayOpenPresents = 0;
+    const char* readbackMode = s_readbackDone ? nullptr : std::getenv("CET_MAC_READBACK");
+    bool readbackNow = false;
+    if (readbackMode && std::strcmp(readbackMode, "overlay") == 0)
+    {
+        s_overlayOpenPresents = CET::Get().GetOverlay().IsEnabled() ? s_overlayOpenPresents + 1 : 0;
+        readbackNow = s_overlayOpenPresents == 60;
+    }
+    else if (readbackMode)
+        readbackNow = m_imguiDrawDataBuffers[0].TotalVtxCount > 0;
+    if (readbackNow)
+    {
+        s_readbackDone = true;
+        const NSUInteger bpp = target.pixelFormat == MTLPixelFormatRGBA16Float ? 8 : 4;
+        const NSUInteger w = target.width, h = target.height;
+        id<MTLBuffer> buffer = [commandBuffer.device newBufferWithLength:w * h * bpp options:MTLResourceStorageModeShared];
+        id<MTLBlitCommandEncoder> blit = [commandBuffer blitCommandEncoder];
+        [blit copyFromTexture:target sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(0, 0, 0) sourceSize:MTLSizeMake(w, h, 1)
+                     toBuffer:buffer destinationOffset:0 destinationBytesPerRow:w * bpp destinationBytesPerImage:w * h * bpp];
+        [blit endEncoding];
+        const auto dir = m_paths.CETRoot();
+        const auto fmt = static_cast<int>(target.pixelFormat);
+        [commandBuffer addCompletedHandler:^(id<MTLCommandBuffer>) {
+            std::ofstream((dir / "readback.raw").string(), std::ios::binary)
+                .write(static_cast<const char*>(buffer.contents), static_cast<std::streamsize>(w * h * bpp));
+            std::ofstream((dir / "readback.txt").string()) << w << " " << h << " " << fmt << "\n";
+        }];
+        Log::Warn("D3D12 (Metal): readback of frame with {} vertices queued", m_imguiDrawDataBuffers[0].TotalVtxCount);
+    }
+}
+
+void* D3D12::CreateTextureRGBA8(const uint8_t* apPixels, int aWidth, int aHeight)
+{
+    if (!m_device || !apPixels || aWidth <= 0 || aHeight <= 0)
+        return nullptr;
+    id<MTLDevice> device = (__bridge id<MTLDevice>)m_device;
+    MTLTextureDescriptor* desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA8Unorm
+                                                                                    width:aWidth
+                                                                                   height:aHeight
+                                                                                mipmapped:NO];
+    desc.usage = MTLTextureUsageShaderRead;
+    desc.storageMode = MTLStorageModeShared;
+    id<MTLTexture> texture = [device newTextureWithDescriptor:desc];
+    [texture replaceRegion:MTLRegionMake2D(0, 0, aWidth, aHeight) mipmapLevel:0 withBytes:apPixels bytesPerRow:aWidth * 4];
+    return (void*)CFBridgingRetain(texture);
+}
+
+void D3D12::ReleaseTexture(void* apTexture)
+{
+    if (!apTexture)
+        return;
+    // Deferred like font atlases: staged draw data may still reference the texture.
+    std::lock_guard _(m_imguiLock);
+    m_retiredTextures.emplace_back(apTexture, m_presentCount);
+}
