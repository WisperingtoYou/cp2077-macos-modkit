new file mode 100644
index 0000000..95053df
--- /dev/null
+++ b/src/macos/MacPlatform.h
@@ -0,0 +1,27 @@
+#pragma once
+
+// macOS replacements for the few Win32 services CET's portable code needs (src/macos/MacPlatform.cpp).
+#ifdef __APPLE__
+
+#include <cstddef>
+#include <cstdint>
+
+namespace CETMac
+{
+// OodleLZ_Decompress has the same signature in every Oodle build CET talks to.
+using TOodleLZ_Decompress = size_t (*)(char* in, int insz, char* out, int outsz, int wantsFuzzSafety, int b, int c, void* d, void* e, void* f, void* g,
+                                       void* workBuffer, size_t workBufferSize, int j);
+
+// The game links Oodle statically and exports nothing. Returns a shim with CET's signature that calls the game's own
+// OodleLZ_Decompress (found by its prologue, research/re_oodle), or one from an Oodle dylib the user placed in CET's
+// folder (liboo2coremac64*.dylib), or nullptr. The shim passes the sizes as intptr_t (CET's int would leave the upper
+// halves of x1/x3 undefined on arm64) and always supplies its own 512 KiB decoder memory: once the game has decoded a
+// KARK itself, Oodle's allocator is CDPR's, which traps on any allocation.
+TOodleLZ_Decompress GetOodleDecompress();
+
+// Overwrites code in the game's __TEXT: mach_vm_protect(R|W|COPY) -> write -> restore R|X -> sys_icache_invalidate.
+// Replaces VirtualProtect(PAGE_EXECUTE_WRITECOPY) + memcpy. Returns false (and writes nothing) on failure.
+bool PatchCode(void* apAddress, const void* apBytes, size_t aSize);
+} // namespace CETMac
+
+#endif
diff --git a/src/macos/MinHook.h b/src/macos/MinHook.h
new file mode 100644
index 0000000..0c25c9c
--- /dev/null
+++ b/src/macos/MinHook.h
@@ -0,0 +1,42 @@
+#pragma once
+
+// macOS: the MinHook calls CET makes, forwarded to RED4ext-macos' native arm64 hook engine (sdk->hooking).
+// CET runs as a RED4ext plugin on macOS (src/macos/PluginMain.cpp), which provides the SDK handle.
+
+typedef enum MH_STATUS
+{
+    MH_UNKNOWN = -1,
+    MH_OK = 0,
+    MH_ERROR_ALREADY_INITIALIZED,
+    MH_ERROR_NOT_INITIALIZED,
+    MH_ERROR_ALREADY_CREATED,
+    MH_ERROR_NOT_CREATED,
+    MH_ERROR_ENABLED,
+    MH_ERROR_DISABLED,
+    MH_ERROR_NOT_EXECUTABLE,
+    MH_ERROR_UNSUPPORTED_FUNCTION,
+    MH_ERROR_MEMORY_ALLOC,
+    MH_ERROR_MEMORY_PROTECT,
+    MH_ERROR_MODULE_NOT_FOUND,
+    MH_ERROR_FUNCTION_NOT_FOUND
+} MH_STATUS;
+
+#define MH_ALL_HOOKS nullptr
+
+MH_STATUS MH_Initialize();
+MH_STATUS MH_Uninitialize();
+// The hook is installed by RED4ext immediately; *ppOriginal receives the trampoline.
+MH_STATUS MH_CreateHook(void* pTarget, void* pDetour, void** ppOriginal);
+MH_STATUS MH_EnableHook(void* pTarget);
+MH_STATUS MH_DisableHook(void* pTarget);
+const char* MH_StatusToString(MH_STATUS status);
+
+namespace CETMac
+{
+struct PluginContext
+{
+    void* handle = nullptr;    // RED4ext::v1::PluginHandle
+    const void* sdk = nullptr; // const RED4ext::v1::Sdk*
+};
+PluginContext& Plugin();
+}
diff --git a/src/macos/MinHookCompat.cpp b/src/macos/MinHookCompat.cpp
new file mode 100644
index 0000000..f56d7f3
--- /dev/null
+++ b/src/macos/MinHookCompat.cpp
@@ -0,0 +1,96 @@
+#include <stdafx.h>
+
+#include "macos/MinHook.h"
+
+#include <RED4ext/Api/v1/Sdk.hpp>
+
+#include <mutex>
+#include <unordered_set>
+
+namespace
+{
+std::mutex s_lock;
+std::unordered_set<void*> s_hooked;
+
+const RED4ext::v1::Sdk* Sdk()
+{
+    return static_cast<const RED4ext::v1::Sdk*>(CETMac::Plugin().sdk);
+}
+}
+
+CETMac::PluginContext& CETMac::Plugin()
+{
+    static PluginContext s_context;
+    return s_context;
+}
+
+MH_STATUS MH_Initialize()
+{
+    return Sdk() ? MH_OK : MH_ERROR_NOT_INITIALIZED;
+}
+
+MH_STATUS MH_Uninitialize()
+{
+    std::lock_guard lock(s_lock);
+    if (auto* sdk = Sdk())
+    {
+        for (auto* target : s_hooked)
+            sdk->hooking->Detach(static_cast<RED4ext::v1::PluginHandle>(CETMac::Plugin().handle), target);
+    }
+    s_hooked.clear();
+    return MH_OK;
+}
+
+MH_STATUS MH_CreateHook(void* pTarget, void* pDetour, void** ppOriginal)
+{
+    auto* sdk = Sdk();
+    if (!sdk)
+        return MH_ERROR_NOT_INITIALIZED;
+    if (!pTarget)
+        return MH_ERROR_NOT_EXECUTABLE; // unresolved address (unverified in the DB): fail closed
+    std::lock_guard lock(s_lock);
+    if (s_hooked.contains(pTarget))
+        return MH_ERROR_ALREADY_CREATED;
+    if (!sdk->hooking->Attach(static_cast<RED4ext::v1::PluginHandle>(CETMac::Plugin().handle), pTarget, pDetour, ppOriginal))
+        return MH_ERROR_UNSUPPORTED_FUNCTION;
+    s_hooked.insert(pTarget);
+    return MH_OK;
+}
+
+MH_STATUS MH_EnableHook(void*)
+{
+    return MH_OK; // RED4ext installs hooks on Attach
+}
+
+MH_STATUS MH_DisableHook(void* pTarget)
+{
+    auto* sdk = Sdk();
+    if (!sdk)
+        return MH_ERROR_NOT_INITIALIZED;
+    std::lock_guard lock(s_lock);
+    if (!pTarget)
+    {
+        for (auto* target : s_hooked)
+            sdk->hooking->Detach(static_cast<RED4ext::v1::PluginHandle>(CETMac::Plugin().handle), target);
+        s_hooked.clear();
+        return MH_OK;
+    }
+    if (!s_hooked.erase(pTarget))
+        return MH_ERROR_NOT_CREATED;
+    sdk->hooking->Detach(static_cast<RED4ext::v1::PluginHandle>(CETMac::Plugin().handle), pTarget);
+    return MH_OK;
+}
+
+const char* MH_StatusToString(MH_STATUS status)
+{
+    switch (status)
+    {
+    case MH_OK: return "MH_OK";
+    case MH_ERROR_NOT_INITIALIZED: return "MH_ERROR_NOT_INITIALIZED (no RED4ext SDK)";
+    case MH_ERROR_ALREADY_CREATED: return "MH_ERROR_ALREADY_CREATED";
+    case MH_ERROR_NOT_CREATED: return "MH_ERROR_NOT_CREATED";
+    case MH_ERROR_NOT_EXECUTABLE: return "MH_ERROR_NOT_EXECUTABLE (unresolved address)";
+    case MH_ERROR_UNSUPPORTED_FUNCTION: return "MH_ERROR_UNSUPPORTED_FUNCTION (RED4ext refused the hook)";
+    default: return "MH_UNKNOWN";
+    }
+}
diff --git a/src/macos/PluginMain.cpp b/src/macos/PluginMain.cpp
new file mode 100644
index 0000000..31167fe
--- /dev/null
+++ b/src/macos/PluginMain.cpp
@@ -0,0 +1,112 @@
+// macOS: CET loads as a RED4ext-macos plugin (red4ext/plugins/CyberEngineTweaks/CyberEngineTweaks.dylib) instead of an
+// ASI in bin/x64. Same startup sequence as src/dllmain.cpp; hooks go through RED4ext (src/macos/MinHookCompat.cpp).
+#include <stdafx.h>
+
+#include "CET.h"
+#include "Options.h"
+#include "macos/MinHook.h"
+
+#include "config/CETVersion.h"
+
+#include <RED4ext/Api/ApiVersion.hpp>
+#include <RED4ext/Api/v1/EMainReason.hpp>
+#include <RED4ext/Api/v1/PluginHandle.hpp>
+#include <RED4ext/Api/v1/PluginInfo.hpp>
+#include <RED4ext/Api/v1/Runtime.hpp>
+#include <RED4ext/Api/v1/Sdk.hpp>
+#include <RED4ext/Api/v1/Version.hpp>
+
+void OptionsInitHook();
+void DisableVignettePatch();
+void DisableBoundaryTeleportPatch();
+
+namespace
+{
+bool s_initialized = false;
+
+void Initialize()
+{
+    try
+    {
+        MH_Initialize();
+
+        CET::Initialize();
+        // CET flushes only at warn and above; the game is often killed rather than shut down, so flush periodically.
+        spdlog::flush_every(std::chrono::seconds(2));
+
+        const auto& options = CET::Get().GetOptions();
+
+        if (options.Patches.DisableVignette)
+            DisableVignettePatch();
+
+        if (options.Patches.DisableBoundaryTeleport)
+            DisableBoundaryTeleportPatch();
+
+        OptionsInitHook();
+
+        MH_EnableHook(nullptr);
+    }
+    catch (const std::exception& e)
+    {
+        spdlog::error("CET initialization failed: {}", e.what());
+    }
+    catch (...)
+    {
+        spdlog::error("CET initialization failed (unknown exception)");
+    }
+}
+
+void Shutdown()
+{
+    const bool inGameProcess = CET::Get().GetOptions().ExeValid;
+
+    MH_DisableHook(nullptr);
+    MH_Uninitialize();
+
+    CET::Shutdown();
+
+    if (inGameProcess)
+    {
+        spdlog::default_logger()->flush();
+        if (auto scripting = spdlog::get("scripting"))
+            scripting->flush();
+    }
+}
+}
+
+RED4EXT_C_EXPORT bool RED4EXT_CALL Main(RED4ext::v1::PluginHandle aHandle, RED4ext::v1::EMainReason aReason,
+                                        const RED4ext::v1::Sdk* aSdk)
+{
+    switch (aReason)
+    {
+    case RED4ext::v1::EMainReason::Load:
+        if (s_initialized)
+            return true;
+        s_initialized = true;
+        CETMac::Plugin().handle = aHandle;
+        CETMac::Plugin().sdk = aSdk;
+        Initialize();
+        break;
+    case RED4ext::v1::EMainReason::Unload:
+        if (!s_initialized)
+            return true;
+        s_initialized = false;
+        Shutdown();
+        break;
+    }
+    return true;
+}
+
+RED4EXT_C_EXPORT void RED4EXT_CALL Query(RED4ext::v1::PluginInfo* aInfo)
+{
+    aInfo->name = L"Cyber Engine Tweaks";
+    aInfo->author = L"Cyber Engine Tweaks Team (macOS port)";
+    aInfo->version = RED4EXT_V1_SEMVER(CET_VERSION_MAJOR, CET_VERSION_MINOR, CET_VERSION_PATCH);
+    aInfo->runtime = RED4EXT_V1_RUNTIME_VERSION_INDEPENDENT;
+    aInfo->sdk = RED4EXT_V1_SDK_VERSION_1_0_0_COMPAT_0_5_0;
+}
+
+RED4EXT_C_EXPORT uint32_t RED4EXT_CALL Supports()
+{
+    return RED4EXT_API_VERSION_1_COMPAT_0;
+}
