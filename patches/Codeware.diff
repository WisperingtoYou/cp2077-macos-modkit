diff --git a/src/Red/MacCompat.hpp b/src/Red/MacCompat.hpp
new file mode 100644
index 00000000..9615c62d
--- /dev/null
+++ b/src/Red/MacCompat.hpp
@@ -0,0 +1,62 @@
+#pragma once
+
+// macOS-only additions that MSVC/psiberx's SDK fork provided implicitly.
+#ifdef __APPLE__
+#include "Core/Facades/Log.hpp"
+
+template<>
+struct std::hash<RED4ext::ent::EntityID>
+{
+    std::size_t operator()(const RED4ext::ent::EntityID& aId) const noexcept
+    {
+        return std::hash<uint64_t>{}(aId.hash);
+    }
+};
+
+namespace Red
+{
+/**
+ * macOS: an opaque N-byte value that a game function returns through x8 (arm64 indirect result register).
+ *
+ * The user-provided destructor makes the type non-trivially copyable, so clang also passes the result address in x8
+ * when Codeware declares, calls or hooks such a function. A trivially copyable struct of 16 bytes or less would be
+ * returned in x0/x1 instead, which is wrong for these functions. Same helper as ArchiveXL-macos (src/Red/Common.hpp).
+ */
+template<size_t N>
+struct SretValue
+{
+    ~SretValue() {} // NOLINT: must stay user-provided, see above
+
+    alignas(8) uint8_t data[N];
+};
+static_assert(!std::is_trivially_copyable_v<SretValue<8>>);
+
+/**
+ * Fail-closed layout check: true only when the RTTI property aName of T is at aOffset, the offset Codeware was compiled
+ * with. Use it before touching a field of a class whose macOS layout is not verified, so a stale header disables the
+ * feature instead of corrupting memory.
+ */
+template<typename T>
+inline bool HasPropertyAt(CName aName, size_t aOffset)
+{
+    auto* type = GetClass<T>();
+    if (!type)
+        return false;
+
+    auto* prop = type->GetProperty(aName);
+    return prop && prop->valueOffset == aOffset;
+}
+}
+
+// True when _type::_field is where the game's RTTI says it is (see Red::HasPropertyAt).
+#define RED_FIELD_MATCHES_RTTI(_type, _field) Red::HasPropertyAt<_type>(#_field, __builtin_offsetof(_type, _field))
+
+// Logs once that a feature is compiled out on macOS (its engine function is inlined, unverified or missing there).
+#define CODEWARE_MAC_UNSUPPORTED(_feature)                                                                            \
+    do                                                                                                                 \
+    {                                                                                                                  \
+        static std::once_flag s_macUnsupportedOnce;                                                                    \
+        std::call_once(s_macUnsupportedOnce,                                                                           \
+                       [] { Core::Log::Warning("[Codeware] {} is not supported on macOS yet.", _feature); });              \
+    } while (false)
+#endif
