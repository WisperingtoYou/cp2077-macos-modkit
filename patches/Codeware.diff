+#include "App/Platform/Keyboard.hpp"
+
+#import <AppKit/AppKit.h>
+#import <Carbon/Carbon.h>
+
+#include <mutex>
+
+namespace
+{
+std::mutex s_layoutMutex;
+CFDataRef s_layoutData = nullptr; // retained copy of kTISPropertyUnicodeKeyLayoutData
+bool s_observing = false;
+
+// Text Input Sources must be queried on the main thread; cache the layout and refresh it when the user switches.
+void RefreshLayoutOnMain()
+{
+    TISInputSourceRef source = TISCopyCurrentKeyboardLayoutInputSource();
+    if (!source)
+        return;
+    auto data = static_cast<CFDataRef>(TISGetInputSourceProperty(source, kTISPropertyUnicodeKeyLayoutData));
+    CFDataRef copy = data ? CFDataCreateCopy(kCFAllocatorDefault, data) : nullptr;
+    CFRelease(source);
+    std::lock_guard lock(s_layoutMutex);
+    if (s_layoutData)
+        CFRelease(s_layoutData);
+    s_layoutData = copy;
+}
+
+void EnsureLayout()
+{
+    static std::once_flag once;
+    std::call_once(once, [] {
+        auto setup = ^{
+            RefreshLayoutOnMain();
+            if (!s_observing)
+            {
+                s_observing = true;
+                [[NSDistributedNotificationCenter defaultCenter]
+                    addObserverForName:(__bridge NSString*)kTISNotifySelectedKeyboardInputSourceChanged
+                                object:nil
+                                 queue:[NSOperationQueue mainQueue]
+                            usingBlock:^(NSNotification*) { RefreshLayoutOnMain(); }];
+            }
+        };
+        if ([NSThread isMainThread])
+            setup();
+        else
+            dispatch_async(dispatch_get_main_queue(), setup);
+    });
+}
+
+// Windows VK code -> macOS ANSI virtual keycode, for the keys Codeware treats as character input.
+int ToMacKeyCode(uint32_t aVk)
+{
+    if (aVk >= 'A' && aVk <= 'Z')
+    {
+        static constexpr int letters[26] = {kVK_ANSI_A, kVK_ANSI_B, kVK_ANSI_C, kVK_ANSI_D, kVK_ANSI_E, kVK_ANSI_F,
+                                            kVK_ANSI_G, kVK_ANSI_H, kVK_ANSI_I, kVK_ANSI_J, kVK_ANSI_K, kVK_ANSI_L,
+                                            kVK_ANSI_M, kVK_ANSI_N, kVK_ANSI_O, kVK_ANSI_P, kVK_ANSI_Q, kVK_ANSI_R,
+                                            kVK_ANSI_S, kVK_ANSI_T, kVK_ANSI_U, kVK_ANSI_V, kVK_ANSI_W, kVK_ANSI_X,
+                                            kVK_ANSI_Y, kVK_ANSI_Z};
+        return letters[aVk - 'A'];
+    }
+    if (aVk >= '0' && aVk <= '9')
+    {
+        static constexpr int digits[10] = {kVK_ANSI_0, kVK_ANSI_1, kVK_ANSI_2, kVK_ANSI_3, kVK_ANSI_4,
+                                           kVK_ANSI_5, kVK_ANSI_6, kVK_ANSI_7, kVK_ANSI_8, kVK_ANSI_9};
+        return digits[aVk - '0'];
+    }
+    if (aVk >= 0x60 && aVk <= 0x69)
+    {
+        static constexpr int pad[10] = {kVK_ANSI_Keypad0, kVK_ANSI_Keypad1, kVK_ANSI_Keypad2, kVK_ANSI_Keypad3,
+                                        kVK_ANSI_Keypad4, kVK_ANSI_Keypad5, kVK_ANSI_Keypad6, kVK_ANSI_Keypad7,
+                                        kVK_ANSI_Keypad8, kVK_ANSI_Keypad9};
+        return pad[aVk - 0x60];
+    }
+    switch (aVk)
+    {
+    case 0x20: return kVK_Space;
+    case 0x6A: return kVK_ANSI_KeypadMultiply;
+    case 0x6B: return kVK_ANSI_KeypadPlus;
+    case 0x6D: return kVK_ANSI_KeypadMinus;
+    case 0x6E: return kVK_ANSI_KeypadDecimal;
+    case 0x6F: return kVK_ANSI_KeypadDivide;
+    case 0xBA: return kVK_ANSI_Semicolon;
+    case 0xBB: return kVK_ANSI_Equal;
+    case 0xBC: return kVK_ANSI_Comma;
+    case 0xBD: return kVK_ANSI_Minus;
+    case 0xBE: return kVK_ANSI_Period;
+    case 0xBF: return kVK_ANSI_Slash;
+    case 0xC0: return kVK_ANSI_Grave;
+    case 0xDB: return kVK_ANSI_LeftBracket;
+    case 0xDC: return kVK_ANSI_Backslash;
+    case 0xDD: return kVK_ANSI_RightBracket;
+    case 0xDE: return kVK_ANSI_Quote;
+    default: return -1;
+    }
+}
+}
+
+std::string App::Platform::KeyToCharacter(uint32_t aVirtualKey)
+{
+    EnsureLayout();
+
+    const int keyCode = ToMacKeyCode(aVirtualKey);
+    if (keyCode < 0)
+        return {};
+
+    const CGEventFlags flags = CGEventSourceFlagsState(kCGEventSourceStateHIDSystemState);
+    if (flags & (kCGEventFlagMaskCommand | kCGEventFlagMaskControl))
+        return {};
+
+    UInt32 modifiers = 0;
+    if (flags & kCGEventFlagMaskShift)
+        modifiers |= shiftKey;
+    if (flags & kCGEventFlagMaskAlternate)
+        modifiers |= optionKey;
+    if (flags & kCGEventFlagMaskAlphaShift)
+        modifiers |= alphaLock;
+
+    std::lock_guard lock(s_layoutMutex);
+    if (!s_layoutData)
+        return {};
+
+    auto layout = reinterpret_cast<const UCKeyboardLayout*>(CFDataGetBytePtr(s_layoutData));
+    UInt32 deadKeyState = 0;
+    UniChar chars[4]{};
+    UniCharCount length = 0;
+    const OSStatus status = UCKeyTranslate(layout, static_cast<UInt16>(keyCode), kUCKeyActionDown, (modifiers >> 8) & 0xFF,
+                                           LMGetKbdType(), kUCKeyTranslateNoDeadKeysBit, &deadKeyState, 4, &length, chars);
+    if (status != noErr || length == 0)
+        return {};
+
+    NSString* text = [NSString stringWithCharacters:chars length:length];
+    const char* utf8 = [text UTF8String];
+    return utf8 ? std::string(utf8) : std::string();
+}
