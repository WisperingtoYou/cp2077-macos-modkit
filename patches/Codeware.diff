--- /dev/null
+++ b/src/App/Platform/SettingsCompat.cpp
@@ -0,0 +1,48 @@
+#include "SettingsCompat.hpp"
+
+namespace Raw::UserSettingsGroup
+{
+constexpr auto GetVar = Core::RawFunc<
+    /* addr = */ Red::AddressLib::userSettingsGroup_GetVar,
+    /* type = */ void (*)(Red::IScriptable* aGroup, Red::CStackFrame* aFrame, Red::Handle<Red::IScriptable>* aOut,
+                          int64_t a4)>();
+}
+
+void App::SettingsCompat::OnBootstrap()
+{
+    if (!Hook<Raw::UserSettingsGroup::GetVar>(&OnGetVar))
+    {
+        LogWarning("[SettingsCompat] ConfigGroup.GetVar hook failed; reading a missing setting will crash the game.");
+    }
+}
+
+void App::SettingsCompat::OnGetVar(Red::IScriptable* aGroup, Red::CStackFrame* aFrame,
+                                   Red::Handle<Red::IScriptable>* aOut, int64_t a4)
+{
+    // Peek at the name argument, then rewind so the original handler reads it again.
+    auto* code = aFrame->code;
+    Red::CName name;
+    Red::GetParameter(aFrame, &name);
+    aFrame->code = code;
+
+    bool hasVar = true;
+    if (aGroup && !Red::CallVirtual(aGroup, "HasVar", hasVar, name))
+    {
+        hasVar = true; // couldn't ask: keep the game's behaviour
+    }
+
+    if (!hasVar)
+    {
+        Red::GetParameter(aFrame, &name);
+        ++aFrame->code; // ParamEnd
+        if (aOut)
+        {
+            *aOut = {};
+        }
+        LogWarning("[SettingsCompat] Setting \"{}\" doesn't exist on macOS; ConfigGroup.GetVar returns null.",
+                   name.ToString());
+        return;
+    }
+
+    Raw::UserSettingsGroup::GetVar(aGroup, aFrame, aOut, a4);
+}
