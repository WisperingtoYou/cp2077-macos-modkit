--- /dev/null
+++ b/src/App/Platform/Clipboard.mm
@@ -0,0 +1,25 @@
+#include "App/Platform/Clipboard.hpp"
+
+#import <AppKit/AppKit.h>
+
+bool App::Platform::GetClipboardText(std::string& aText)
+{
+    @autoreleasepool
+    {
+        NSString* text = [[NSPasteboard generalPasteboard] stringForType:NSPasteboardTypeString];
+        if (!text)
+            return false;
+        aText = [text UTF8String] ?: "";
+        return true;
+    }
+}
+
+bool App::Platform::SetClipboardText(const char* aText)
+{
+    @autoreleasepool
+    {
+        NSPasteboard* board = [NSPasteboard generalPasteboard];
+        [board clearContents];
+        return [board setString:[NSString stringWithUTF8String:aText ? aText : ""] forType:NSPasteboardTypeString];
+    }
+}
