     Register<Core::RuntimeProvider>(aHandle)
+#if defined(_WIN32) || defined(_WIN64)
         ->SetBaseImagePathDepth(2);
+#else
+        ->SetBaseImagePathDepth(3);
+#endif
 
+#if defined(_WIN32) || defined(_WIN64)
     Register<Support::MinHookProvider>();
