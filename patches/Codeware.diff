+namespace App
+{
+// macOS: ConfigGroup.GetVar on a variable this platform doesn't have (Windows-only settings such as
+// /graphics/presets DLSSFrameGen) hits a game assert, and asserts trap on the Mac build. Mods written on Windows read
+// those variables (No More Duplicate NPCs does). Return null for a missing variable instead, as a script would see on
+// a Windows build that lacks the option: the cast fails and the mod falls back to its default.
+class SettingsCompat
+    : public Core::Feature
+    , public Core::HookingAgent
+    , public Core::LoggingAgent
+{
+protected:
+    void OnBootstrap() override;
+
+    static void OnGetVar(Red::IScriptable* aGroup, Red::CStackFrame* aFrame, Red::Handle<Red::IScriptable>* aOut,
+                         int64_t a4);
+};
+}
