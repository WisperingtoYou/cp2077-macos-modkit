+template<typename T>
+inline void DescribeReturnValue(CBaseFunction* aFunc)
+{
+    using U = std::remove_cvref_t<std::remove_pointer_t<T>>;
+
+    if constexpr (!std::is_void_v<U>)
+    {
+        aFunc->SetReturnType(ResolveTypeName<FinalRetType<U>>());
+    }
+}
