diff --git a/macos/include/Registrar.hpp b/macos/include/Registrar.hpp
new file mode 100644
index 0000000..a68eb89
--- /dev/null
+++ b/macos/include/Registrar.hpp
@@ -0,0 +1,162 @@
+#pragma once
+
+// macOS replacement for deps/cpcmake/include/Registrar.hpp (selected by include order in macos/CMakeLists.txt).
+// Differences from the Windows header:
+//  - ModModuleHookHash keeps the address hash and resolves it in Load(), through the RED4ext.SDK address DB
+//    (UniversalRelocBase::Resolve). The Windows header resolved it in a static initializer and subtracted
+//    GetModuleHandle(nullptr).
+//  - Attach goes through the RED4ext-macos hooking API with the absolute address. A hash that does not resolve, or a
+//    hook RED4ext refuses, is logged and skipped (the Windows header retried forever).
+
+#include <RED4ext/RED4ext.hpp>
+
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <string>
+#include <vector>
+
+struct ModModule
+{
+    virtual ~ModModule() = default;
+    virtual void Load(const RED4ext::Sdk*, RED4ext::PluginHandle){};
+    virtual void RegisterTypes(){};
+    virtual void PostRegisterTypes(){};
+    virtual void Unload(const RED4ext::Sdk*, RED4ext::PluginHandle){};
+};
+
+class IModModuleHook : ModModule
+{
+public:
+    std::string m_name;
+    uint32_t m_hash = 0;
+    uintptr_t m_address = 0;
+    void* m_hook = nullptr;
+    void** m_original = nullptr;
+    bool m_attached = false;
+
+    void Load(const RED4ext::Sdk* aSdk, RED4ext::PluginHandle aHandle) override
+    {
+        if (!m_address && m_hash)
+        {
+            m_address = RED4ext::UniversalRelocBase::Resolve(m_hash);
+        }
+        if (!m_address)
+        {
+            aSdk->logger->ErrorF(aHandle, "Hook %s: address hash %u does not resolve, not attached", m_name.c_str(),
+                                 m_hash);
+            return;
+        }
+        m_attached = aSdk->hooking->Attach(aHandle, reinterpret_cast<void*>(m_address), m_hook, m_original);
+        if (m_attached)
+        {
+            aSdk->logger->InfoF(aHandle, "Hook %s attached at %p", m_name.c_str(), reinterpret_cast<void*>(m_address));
+        }
+        else
+        {
+            aSdk->logger->ErrorF(aHandle, "Hook %s: RED4ext refused the hook at %p", m_name.c_str(),
+                                 reinterpret_cast<void*>(m_address));
+        }
+    }
+
+    void Unload(const RED4ext::Sdk* aSdk, RED4ext::PluginHandle aHandle) override
+    {
+        if (m_attached)
+        {
+            aSdk->hooking->Detach(aHandle, reinterpret_cast<void*>(m_address));
+            m_attached = false;
+        }
+    }
+};
+
+class ModModuleFactory
+{
+    std::vector<std::function<void(const RED4ext::Sdk*, RED4ext::PluginHandle)>> s_loads;
+    std::vector<std::function<void(const RED4ext::Sdk*, RED4ext::PluginHandle)>> s_unloads;
+    std::vector<std::function<void()>> s_registers;
+    std::vector<std::function<void()>> s_postRegisters;
+    std::vector<IModModuleHook*> s_hooks;
+
+public:
+    static ModModuleFactory& GetInstance()
+    {
+        static ModModuleFactory s_instance;
+        return s_instance;
+    }
+
+    template<class T>
+    void registerClass(const std::string&)
+    {
+        s_loads.emplace_back([](const RED4ext::Sdk* aSdk, RED4ext::PluginHandle aHandle) -> void
+                             { (new T())->Load(aSdk, aHandle); });
+        s_unloads.emplace_back([](const RED4ext::Sdk* aSdk, RED4ext::PluginHandle aHandle) -> void
+                               { (new T())->Unload(aSdk, aHandle); });
+        s_registers.emplace_back([]() -> void { (new T())->RegisterTypes(); });
+        s_postRegisters.emplace_back([]() -> void { (new T())->PostRegisterTypes(); });
+    }
+
+    void registerHook(IModModuleHook* aHook)
+    {
+        s_hooks.emplace_back(aHook);
+    }
+
+    void Load(const RED4ext::Sdk* aSdk, RED4ext::PluginHandle aHandle)
+    {
+        for (const auto& load : s_loads)
+            load(aSdk, aHandle);
+        for (const auto& hook : s_hooks)
+            hook->Load(aSdk, aHandle);
+    }
+
+    void Unload(const RED4ext::Sdk* aSdk, RED4ext::PluginHandle aHandle)
+    {
+        for (const auto& unload : s_unloads)
+            unload(aSdk, aHandle);
+        for (const auto& hook : s_hooks)
+            hook->Unload(aSdk, aHandle);
+    }
+
+    void RegisterTypes()
+    {
+        for (const auto& reg : s_registers)
+            reg();
+    }
+
+    void PostRegisterTypes()
+    {
+        for (const auto& reg : s_postRegisters)
+            reg();
+    }
+};
+
+template<class T>
+class ModModuleRegister
+{
+public:
+    explicit ModModuleRegister(const std::string& aName)
+    {
+        ModModuleFactory::GetInstance().registerClass<T>(aName);
+    }
+};
+
+#define REGISTER_MODULE(derived_class) ModModuleRegister<derived_class> s_##derived_class##Creator(#derived_class);
+
+class ModModuleHookHash : IModModuleHook
+{
+public:
+    explicit ModModuleHookHash(std::string aName, uint32_t aHash, void* aHook, void** aOriginal)
+    {
+        this->m_name = std::move(aName);
+        this->m_hash = aHash;
+        this->m_hook = aHook;
+        this->m_original = aOriginal;
+        ModModuleFactory::GetInstance().registerHook(this);
+    }
+};
+
+#define REGISTER_HOOK_HASH(retType, hash, func, ...)                                                                   \
+    retType func(__VA_ARGS__);                                                                                         \
+    decltype(&func) func##_Original;                                                                                   \
+    ModModuleHookHash s_##func##_Hook(#func, hash, reinterpret_cast<void*>(&func),                                     \
+                                      reinterpret_cast<void**>(&func##_Original));                                     \
+    retType func(__VA_ARGS__)
diff --git a/macos/src/MacPlatform.cpp b/macos/src/MacPlatform.cpp
new file mode 100644
index 0000000..a68d2ab
--- /dev/null
+++ b/macos/src/MacPlatform.cpp
@@ -0,0 +1,119 @@
+// macOS platform helpers for Mod Settings (see macos/include/ModSettingsMac.hpp).
+#include <ModSettingsMac.hpp>
+
+#include <cstring>
+#include <vector>
+
+#include <dlfcn.h>
+#include <libkern/OSCacheControl.h>
+#include <mach-o/dyld.h>
+#include <mach-o/loader.h>
+#include <mach/mach.h>
+#include <mach/mach_vm.h>
+
+namespace ModSettingsMac
+{
+std::filesystem::path GetExecutablePath()
+{
+    uint32_t size = 0;
+    _NSGetExecutablePath(nullptr, &size);
+    std::vector<char> buffer(size + 1, '\0');
+    if (_NSGetExecutablePath(buffer.data(), &size) != 0)
+    {
+        return {};
+    }
+
+    std::error_code ec;
+    auto path = std::filesystem::path(buffer.data());
+    auto canonical = std::filesystem::weakly_canonical(path, ec);
+    return ec ? path : canonical;
+}
+
+std::filesystem::path GetGameRoot()
+{
+    // <root>/Cyberpunk2077.app/Contents/MacOS/Cyberpunk2077
+    return GetExecutablePath()
+        .parent_path()  // MacOS
+        .parent_path()  // Contents
+        .parent_path()  // Cyberpunk2077.app
+        .parent_path(); // game root
+}
+
+std::filesystem::path GetPluginDir()
+{
+    Dl_info info{};
+    if (dladdr(reinterpret_cast<const void*>(&GetPluginDir), &info) == 0 || !info.dli_fname)
+    {
+        return GetGameRoot() / "red4ext" / "plugins" / "mod_settings";
+    }
+    return std::filesystem::path(info.dli_fname).parent_path();
+}
+
+const void* GetGameImageBase()
+{
+    for (uint32_t i = 0, count = _dyld_image_count(); i < count; ++i)
+    {
+        const auto* header = reinterpret_cast<const mach_header_64*>(_dyld_get_image_header(i));
+        if (header && header->filetype == MH_EXECUTE)
+        {
+            return header;
+        }
+    }
+    return nullptr;
+}
+
+namespace
+{
+bool Protect(void* aAddress, size_t aSize, vm_prot_t aProtection)
+{
+    const auto pageSize = static_cast<uintptr_t>(vm_page_size);
+    const auto start = reinterpret_cast<uintptr_t>(aAddress) & ~(pageSize - 1);
+    const auto end = (reinterpret_cast<uintptr_t>(aAddress) + aSize + pageSize - 1) & ~(pageSize - 1);
+    return mach_vm_protect(mach_task_self(), start, end - start, false, aProtection) == KERN_SUCCESS;
+}
+} // namespace
+
+void* SwapDataPointer(void** aSlot, void* aExpected, void* aReplacement)
+{
+    if (!aSlot || *aSlot != aExpected)
+    {
+        return nullptr;
+    }
+
+    // __DATA_CONST is read-only after dyld applied the fixups; VM_PROT_COPY makes the page private and writable.
+    if (!Protect(aSlot, sizeof(void*), VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY))
+    {
+        return nullptr;
+    }
+
+    auto* previous = __atomic_exchange_n(aSlot, aReplacement, __ATOMIC_SEQ_CST);
+    Protect(aSlot, sizeof(void*), VM_PROT_READ);
+    return previous;
+}
+
+uint32_t ReadInstruction(const void* aAddress)
+{
+    uint32_t word = 0;
+    std::memcpy(&word, aAddress, sizeof(word));
+    return word;
+}
+
+bool PatchInstruction(void* aAddress, uint32_t aExpected, uint32_t aReplacement)
+{
+    if (!aAddress || ReadInstruction(aAddress) != aExpected)
+    {
+        return false;
+    }
+
+    // Same sequence as CET-mac (CETMac::PatchCode): RW + COPY, write, back to RX, flush the instruction cache.
+    if (!Protect(aAddress, sizeof(uint32_t), VM_PROT_READ | VM_PROT_WRITE | VM_PROT_COPY))
+    {
+        return false;
+    }
+
+    __atomic_store_n(reinterpret_cast<uint32_t*>(aAddress), aReplacement, __ATOMIC_SEQ_CST);
+    const bool restored = Protect(aAddress, sizeof(uint32_t), VM_PROT_READ | VM_PROT_EXECUTE);
+    sys_icache_invalidate(aAddress, sizeof(uint32_t));
+    return restored && ReadInstruction(aAddress) == aReplacement;
+}
+} // namespace ModSettingsMac
