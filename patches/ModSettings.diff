+  const auto dmg = abi::__cxa_demangle(tn, nullptr, nullptr, nullptr);
+  const auto pname = pretty_name(dmg);
+  const auto name = string{pname.data(), pname.size()};
+  free(dmg);
+  assert(!name.empty() && "Type does not have a short name.");
