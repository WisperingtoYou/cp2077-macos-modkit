+template<typename T>
+inline T* GetPropertyPtr(ISerializable* aContext, CName aProp)
+{
+    if (!aContext)
+        return nullptr;
+
+    auto prop = aContext->GetType()->GetProperty(aProp);
+    if (!prop)
+        return nullptr;
+
+    return prop->GetValuePtr<T>(aContext);
+}
+
+template<typename T>
+inline T* GetPropertyPtr(void* aContext, CClass* aType, CName aProp)
+{
+    if (!aContext || !aType)
+        return nullptr;
