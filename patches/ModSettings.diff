+using FunctionFlagsStorage = uint32_t;
+static_assert(sizeof(CBaseFunction::Flags) == sizeof(FunctionFlagsStorage));
+constexpr auto FunctionSpecialFlag = 1 << (8 * sizeof(FunctionFlagsStorage) - 1);
