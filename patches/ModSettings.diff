+#pragma once
+
+// macOS (Itanium C++ ABI) version of jackhumbert/RED4ext.SDK's userRuntimeSettingsVar.hpp (b5ea591), reduced to the
+// base class Mod Settings derives from. Only the virtual-table shape changes:
+//  - MSVC has one scalar-deleting destructor slot (0x08); clang emits the complete and the deleting destructor (0x08,
+//    0x10), so every later slot moves by +8.
+//  - Checked against the 2.3.1 binary (game::user natives, Mac addresses):
+//      native_userSettingsVar::WasModifiedSinceLastSave 0x10489D038 calls runtimeVar vt+0x18
+//      native_userSettingsVar::HasRequestedValue        0x10489D078 calls runtimeVar vt+0x20
+//      native_userSettingsVar::RestoreDefault           0x10489D0B8 calls runtimeVar vt+0x30 (w1 = 2)
+//      RuntimeSettingsVarBool setter                    0x101E5C1A8 calls vt+0x38 (SetRequestedValue)
+//    Field reads in the same natives: name +0x08, groupPath +0x10, displayName +0x18, displayNameKeys size +0x2C,
+//    type +0x40, updatePolicy +0x41, flags +0x44, order +0x48. All match the Windows layout below.
+
+#include <cstdint>
+
+#include <RED4ext/CName.hpp>
+#include <RED4ext/Common.hpp>
+#include <RED4ext/Containers/DynArray.hpp>
+#include <RED4ext/Memory/Allocators.hpp>
+
+namespace RED4ext
+{
+namespace user
+{
+struct ConfigVarFlags
+{
+    uint32_t isInPreGame : 1;            // 0x001
+    uint32_t isInGame : 1;               // 0x002
+    uint32_t isVisible : 1;              // 0x004
+    uint32_t isPlatformSpecific : 1;     // 0x008
+    uint32_t isDynamic : 1;              // 0x010
+    uint32_t unk20 : 1;                  // 0x020
+    uint32_t isInitialized : 1;          // 0x040
+    uint32_t listHasDisplayValues : 1;   // 0x080
+    uint32_t canBeRestoredToDefault : 1; // 0x100
+    uint32_t isInput : 1;                // 0x200
+    uint32_t isDisabled : 1;             // 0x400
+};
+static_assert(sizeof(ConfigVarFlags) == 4);
+
+enum class EConfigVarType : char
+{
+    Bool = 0,
+    Int = 1,
+    Float = 2,
+    Name = 3,
+    IntList = 4,
+    FloatList = 5,
+    StringList = 6,
+    NameList = 7,
+};
+
+enum class EConfigVarUpdatePolicy : char
+{
+    Disabled = 0,
+    Immediately = 1,
+    ConfirmationRequired = 2,
+    RestartRequired = 3,
+    LoadLastCheckpointRequired = 4,
+};
+
+enum class EConfigVarImportPolicy : char
+{
+    ReadValue = 0x0,
+    Ignore = 0x1
+};
+
+#pragma pack(push, 1)
+struct RuntimeSettingsVar
+{
+    RuntimeSettingsVar()
+    {
+        displayNameKeys = DynArray<CName>(new Memory::DefaultAllocator());
+        unk44 = 0xFF;
+        unk45 = 0xFF;
+        bitfield = ConfigVarFlags{};
+    }
+
+    virtual Memory::IAllocator* GetAllocator() // 00
+    {
+        return new Memory::DefaultAllocator();
+    }
+    virtual ~RuntimeSettingsVar() = default;         // 08 (D1), 10 (D0)
+    virtual bool WasModifiedSinceLastSave() = 0;     // 18
+    virtual bool HasChange() = 0;                    // 20 HasRequestedValue
+    virtual bool IsDefault() = 0;                    // 28 HasDefaultValue
+    virtual bool RestoreDefault(uint8_t) = 0;        // 30
+    virtual void SetRequestedValue(void* value) = 0; // 38
+    virtual void AcceptChange() = 0;                 // 40
+    virtual void RejectChange() = 0;                 // 48
+    virtual void MarkAsSaved() = 0;                  // 50
+    virtual void LoadValue(void* value) = 0;         // 58
+
+    CName name = CName();            // 08
+    CName groupPath = CName();       // 10
+    CName displayName = CName();     // 18
+    DynArray<CName> displayNameKeys; // 20
+    CName description = CName();     // 30
+    CName warning = CName();         // 38 (2.3)
+    EConfigVarType type;             // 40
+    EConfigVarUpdatePolicy updatePolicy = EConfigVarUpdatePolicy::Immediately; // 41
+    EConfigVarImportPolicy importPolicy = EConfigVarImportPolicy::ReadValue;   // 42
+    uint8_t unk3B;                   // 43
+    ConfigVarFlags bitfield;         // 44
+    uint32_t order;                  // 48
+    uint8_t unk44;                   // 4C last update flag
+    uint8_t unk45;                   // 4D
+    uint8_t unk46;                   // 4E
+    uint8_t unk47;                   // 4F
+    uint32_t unk50_new;              // 50
+};
+#pragma pack(pop)
+RED4EXT_ASSERT_SIZE(RuntimeSettingsVar, 0x54);
+RED4EXT_ASSERT_OFFSET(RuntimeSettingsVar, name, 0x08);
+RED4EXT_ASSERT_OFFSET(RuntimeSettingsVar, groupPath, 0x10);
+RED4EXT_ASSERT_OFFSET(RuntimeSettingsVar, displayName, 0x18);
+RED4EXT_ASSERT_OFFSET(RuntimeSettingsVar, displayNameKeys, 0x20);
+RED4EXT_ASSERT_OFFSET(RuntimeSettingsVar, type, 0x40);
+RED4EXT_ASSERT_OFFSET(RuntimeSettingsVar, updatePolicy, 0x41);
+RED4EXT_ASSERT_OFFSET(RuntimeSettingsVar, bitfield, 0x44);
+RED4EXT_ASSERT_OFFSET(RuntimeSettingsVar, order, 0x48);
+
+} // namespace user
+} // namespace RED4ext
