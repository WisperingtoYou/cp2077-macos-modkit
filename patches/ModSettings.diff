index 0000000..a6dab76
--- /dev/null
+++ b/macos/include/ArchiveXL.hpp
@@ -0,0 +1,167 @@
+#pragma once
+
+// macOS variant of deps/archive_xl/support/red4ext/ArchiveXL.hpp (selected by include order in macos/CMakeLists.txt).
+// Changes: GetModulePath uses dladdr() on an address inside this dylib instead of GetModuleFileNameW(HMODULE), and
+// Initialize() drops the Memory::Vault check (see there). The facade calls (RTTI class "ArchiveXL",
+// RegisterArchive/RegisterDir) are unchanged.
+
+#include <filesystem>
+#include <vector>
+
+#include <dlfcn.h>
+
+#include <RED4ext/Callback.hpp>
+#include <RED4ext/Memory/Allocators.hpp>
+#include <RED4ext/RTTISystem.hpp>
+
+class ArchiveXL
+{
+public:
+    inline static bool RegisterArchive(std::filesystem::path aPath)
+    {
+        std::error_code error;
+
+        if (!std::filesystem::exists(aPath, error) || !std::filesystem::is_regular_file(aPath, error))
+        {
+            return false;
+        }
+
+        return RegisterPathOrQueue(std::move(aPath));
+    }
+
+    inline static bool RegisterArchive(HMODULE aHandle, std::filesystem::path aPath)
+    {
+        if (aPath.is_relative())
+        {
+            aPath = GetModulePath(aHandle) / aPath;
+        }
+
+        return RegisterArchive(std::move(aPath));
+    }
+
+    inline static bool RegisterArchives(std::filesystem::path aPath)
+    {
+        std::error_code error;
+
+        if (!std::filesystem::exists(aPath, error) || !std::filesystem::is_directory(aPath, error))
+        {
+            return false;
+        }
+
+        return RegisterPathOrQueue(std::move(aPath));
+    }
+
+    inline static bool RegisterArchives(HMODULE aHandle, std::filesystem::path aPath)
+    {
+        if (aPath.is_relative())
+        {
+            aPath = GetModulePath(aHandle) / aPath;
+        }
+
+        return RegisterArchives(std::move(aPath));
+    }
+
+private:
+    ArchiveXL() = default;
+
+    inline static bool Initialize()
+    {
+        if (s_facade)
+            return true;
+
+        // macOS: no Memory::Vault readiness check. The Memory_Vault address hash is wrong in the macOS DB and stays
+        // unverified (RED4ext.SDK docs/ADDRESS_AUDIT.md), so referencing it makes the plugin gate refuse the plugin.
+        // The RTTI system is already usable at plugin Load on macOS (RedLib registers its callbacks there too); the
+        // facade lookup below fails, and the path is queued, until ArchiveXL has registered its class.
+
+        auto facade = RED4ext::CRTTISystem::Get()->GetClass("ArchiveXL");
+
+        if (!facade || !facade->GetFunction("Version"))
+            return false;
+
+        s_facade = facade;
+        return true;
+    }
+
+    inline static bool RegisterPathOrQueue(std::filesystem::path aPath)
+    {
+        // macOS: never look the facade up at plugin Load (that is when Mod Settings registers its archive). Without the
+        // Windows Memory::Vault readiness check, an RTTI class lookup that early broke script data initialization
+        // ("Failed to initialize scripts data!": Codeware's native properties went missing). Queue the path and let
+        // the RTTI post-register callback register it, which is what Windows does while the engine isn't ready.
+        if (!s_facade)
+        {
+            s_paths.push_back(std::move(aPath));
+
+            if (s_paths.size() == 1)
+            {
+                RED4ext::CRTTISystem::Get()->AddPostRegisterCallback(&RegisterPendingPaths);
+            }
+
+            return true;
+        }
+
+        if (!Initialize())
+        {
+            s_paths.push_back(std::move(aPath));
+
+            if (s_paths.size() == 1)
+            {
+                RegisterPendingPaths();
+            }
+
+            return true;
+        }
+
+        return RegisterPath(aPath);
+    }
+
+    inline static bool RegisterPath(const std::filesystem::path& aPath)
+    {
+        bool success;
+        RED4ext::CString path(aPath.string());
+
+        auto rtti = RED4ext::CRTTISystem::Get();
+        RED4ext::CStackType arg(rtti->GetType("String"), &path);
+        RED4ext::CStackType result(rtti->GetType("Bool"), &success);
+        RED4ext::CStack stack(nullptr, &arg, 1, &result);
+
+        std::error_code error;
+        RED4ext::CName method(std::filesystem::is_directory(aPath, error) ? "RegisterDir" : "RegisterArchive");
+
+        s_facade->GetFunction(method)->Execute(&stack);
+
+        return success;
+    }
+
+    static inline void RegisterPendingPaths()
+    {
+        if (Initialize())
+        {
+            for (const auto& path : s_paths)
+            {
+                RegisterPath(path);
+            }
+
+            s_paths.clear();
+        }
+        else
+        {
+            RED4ext::CRTTISystem::Get()->AddPostRegisterCallback(&RegisterPendingPaths);
+        }
+    }
+
+    inline static std::filesystem::path GetModulePath(HMODULE)
+    {
+        Dl_info info{};
+        if (dladdr(reinterpret_cast<const void*>(&ArchiveXL::RegisterPendingPaths), &info) == 0 || !info.dli_fname)
+        {
+            return {};
+        }
+
+        return std::filesystem::path(info.dli_fname).parent_path();
+    }
+
+    inline static RED4ext::CClass* s_facade;
+    inline static std::vector<std::filesystem::path> s_paths;
+};
diff --git a/macos/include/CyberpunkMod.hpp b/macos/include/CyberpunkMod.hpp
new file mode 100644
index 0000000..cb94703
--- /dev/null
+++ b/macos/include/CyberpunkMod.hpp
@@ -0,0 +1,84 @@
+#pragma once
+
+// macOS variant of deps/cpcmake/include/CyberpunkMod.hpp (selected by include order in macos/CMakeLists.txt).
+// TimeTracker uses std::chrono::steady_clock (mach_absolute_time) instead of QueryPerformanceCounter; the arithmetic
+// and the results (microseconds) are the same. LONGLONG is int64_t.
+
+#include <chrono>
+#include <cstdint>
+#include <map>
+
+#include "CNames.hpp"
+#include "Registrar.hpp"
+
+#define S_TO_US 1000000
+#define S_TO_NS 1000000000
+
+namespace CyberpunkMod {
+
+struct TimeTracker {
+  using Clock = std::chrono::steady_clock;
+
+  static inline int64_t Now() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count();
+  }
+
+  inline TimeTracker() {
+    Init = Now();
+  }
+
+  inline int64_t LoopDifference() {
+    return Second - First;
+  }
+
+  inline int64_t TotalDifference() {
+    return First - Init;
+  }
+
+  inline void Start(uint32_t printInterval_s) {
+    First = Now();
+    shouldPrint = TotalDifference() * S_TO_US / Frequency > (int64_t)printInterval_s * S_TO_US;
+  }
+
+  inline int64_t End() {
+    Second = Now();
+    int64_t sum = 0;
+    if (shouldPrint) {
+      sum = recentCallTimes;
+      int64_t div = (TotalDifference() * S_TO_US / Frequency);
+      if (div != 0) {
+        sum = sum * S_TO_US / div;
+      } else {
+        sum = -1;
+      }
+      Init = First;
+      recentCallTimes = 0;
+      shouldPrint = false;
+    }
+    recentCallTimes += (LoopDifference() * S_TO_US / Frequency);
+    return sum;
+  }
+
+  // ticks per second (the clock above counts nanoseconds)
+  static constexpr int64_t Frequency = S_TO_NS;
+  int64_t Init = 0;
+  int64_t First = 0;
+  int64_t Second = 0;
+  int64_t recentCallTimes = 0;
+  bool shouldPrint = false;
+};
+
+struct Profiler {
+  inline static std::map<RED4ext::CName, TimeTracker> timeTrackers;
+  inline Profiler(RED4ext::CName tracker, uint32_t printInterval_s) : m_tracker(tracker) {
+    timeTrackers[m_tracker].Start(printInterval_s);
+  }
+
+  inline int64_t End() {
+    return timeTrackers[m_tracker].End();
+  }
+
+  RED4ext::CName m_tracker;
+};
+
+} // namespace CyberpunkMod
diff --git a/macos/include/ModSettingsMac.hpp b/macos/include/ModSettingsMac.hpp
new file mode 100644
index 0000000..b582dd3
--- /dev/null
+++ b/macos/include/ModSettingsMac.hpp
@@ -0,0 +1,89 @@
+#pragma once
+
+// Force-included into every macOS translation unit (macos/CMakeLists.txt, -include). Not used on Windows.
+
+#ifdef __APPLE__
+
+#include <cstdint>
+#include <filesystem>
+
+#include <RED4ext/RED4ext.hpp>
+
+// The macOS SDK fork only has the v1 API names; map the unversioned ones Mod Settings uses (same as Input Loader).
+namespace RED4ext
+{
+using namespace RED4ext::v1;
+}
+#define RED4EXT_SEMVER RED4EXT_V1_SEMVER
+#define RED4EXT_RUNTIME_INDEPENDENT RED4EXT_V1_RUNTIME_VERSION_INDEPENDENT
+#define RED4EXT_SDK_LATEST RED4EXT_V1_SDK_VERSION_1_0_0_COMPAT_0_5_0
+#define RED4EXT_API_VERSION_LATEST RED4EXT_API_VERSION_1_COMPAT_0
+
+// Removed from the SDK since the jackhumbert fork the Windows build pins (same alias as CET-mac SDKCompat.h).
+namespace RED4ext
+{
+using ScriptInstance = void*;
+}
+
+// RedLib before anything else: stdafx.hpp includes Red/TypeInfo/Registrar.hpp on its own, which needs Red/Alias.hpp.
+#include <RedLib.hpp>
+
+// MSVC calling-convention keyword; arm64 has one convention.
+#ifndef __fastcall
+#define __fastcall
+#endif
+
+namespace ModSettingsMac
+{
+// Game executable path (_NSGetExecutablePath): <root>/Cyberpunk2077.app/Contents/MacOS/Cyberpunk2077.
+std::filesystem::path GetExecutablePath();
+
+// Game root: the executable path up 4 levels (the folder that holds Cyberpunk2077.app, r6/, red4ext/, archive/).
+std::filesystem::path GetGameRoot();
+
+// Folder of this dylib (dladdr), i.e. <root>/red4ext/plugins/mod_settings.
+std::filesystem::path GetPluginDir();
+
+// Load address of the game executable (the MH_EXECUTE image; image 0 is RED4ext.dylib under DYLD_INSERT_LIBRARIES).
+const void* GetGameImageBase();
+
+// Swaps one pointer-sized slot in read-only data (__DATA_CONST) after checking that it holds aExpected.
+// Returns the previous value on success, nullptr if the slot did not hold aExpected or could not be written.
+void* SwapDataPointer(void** aSlot, void* aExpected, void* aReplacement);
+
+// Writes one arm64 instruction in __TEXT after checking that it holds aExpected (vm_protect RW+COPY, write,
+// vm_protect RX, icache invalidate). Returns false and writes nothing if the current word differs.
+bool PatchInstruction(void* aAddress, uint32_t aExpected, uint32_t aReplacement);
+
+// Reads the 32-bit word at aAddress (for logging).
+uint32_t ReadInstruction(const void* aAddress);
+
+// Address hashes for the macOS-only targets of this port. FNV-1a 32 of the name, the same scheme as Codeware-mac and
+// ArchiveXL-macos. The DB entries are in RED4ext.SDK/cyberpunk2077_addresses.json (docs/MACOS_PORT.md).
+namespace Hashes
+{
+constexpr uint32_t Fnv1a32(const char* aText)
+{
+    uint32_t hash = 0x811C9DC5u;
+    while (*aText)
+    {
+        hash ^= static_cast<uint8_t>(*aText++);
+        hash *= 0x01000193u;
+    }
+    return hash;
+}
+
+// game::input::Manager vtable slot +0x258 (2:0x1B45F0 = 0x106F945F0); holds the ApplyOverrides thunk.
+constexpr uint32_t InputManager_ApplyOverridesSlot = 647509972u;
+// The thunk itself (1:0x1D735A4 = 0x101D735A4): what the slot must hold before the swap.
+constexpr uint32_t InputManager_ApplyOverridesThunk = 3781755204u;
+// b.hi in the key-binding listen lambda (1:0x48039B4 = 0x1048039B4) that skips pad keys 6..0x13 (inlined SkipKey).
+constexpr uint32_t KeyBindingListen_PadSkipBranch = 1325863745u;
+
+static_assert(Fnv1a32("ModSettings_InputManager_ApplyOverridesSlot") == InputManager_ApplyOverridesSlot);
+static_assert(Fnv1a32("ModSettings_InputManager_ApplyOverridesThunk") == InputManager_ApplyOverridesThunk);
+static_assert(Fnv1a32("ModSettings_KeyBindingListen_PadSkipBranch") == KeyBindingListen_PadSkipBranch);
+} // namespace Hashes
+} // namespace ModSettingsMac
+
+#endif
