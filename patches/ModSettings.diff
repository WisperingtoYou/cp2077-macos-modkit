+  static_assert(!_name.empty(), "Expression does not have a name.");  \
+  constexpr auto _size = _name.size();                                \
+  constexpr auto _nameof = ::nameof::cstring<_size>{_name};           \
+  return _nameof; }()
+
+// Obtains full name of variable, function, macro.
