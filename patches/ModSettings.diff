@@ -0,0 +1,114 @@
+cmake_minimum_required(VERSION 3.20)
+project(ModSettings VERSION 0.2.21 LANGUAGES CXX)
+
+# macOS arm64 build of Mod Settings as a RED4ext-macos plugin:
+#   cmake -S macos -B build-mac -G Ninja && cmake --build build-mac
+# The Windows build stays on the top-level CMakeLists.txt (cyberpunk_cmake / MSVC).
+# Output: build-mac/mod_settings.dylib and the install layout build-mac/package/red4ext/plugins/mod_settings/.
+if(NOT APPLE)
+    message(FATAL_ERROR "This CMake build is for macOS; build Windows with the top-level CMakeLists.txt.")
+endif()
+
+set(CMAKE_CXX_STANDARD 20)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(CMAKE_OSX_ARCHITECTURES "arm64")
+set(CMAKE_OSX_DEPLOYMENT_TARGET "15.0")
+set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+if(NOT CMAKE_BUILD_TYPE)
+    set(CMAKE_BUILD_TYPE Release)
+endif()
+set(ROOT "${CMAKE_CURRENT_SOURCE_DIR}/..")
+
+# RED4ext.SDK macOS fork (header-only); the address DB lives in the same checkout.
+set(RED4EXT_SDK_DIR "${ROOT}/../RED4ext.SDK" CACHE PATH "RED4ext.SDK (macOS) repository root")
+if(NOT EXISTS "${RED4EXT_SDK_DIR}/include/RED4ext/RED4ext.hpp")
+    message(FATAL_ERROR "RED4ext.SDK not found at ${RED4EXT_SDK_DIR}; pass -DRED4EXT_SDK_DIR=<path>.")
+endif()
+
+# Plugin folder name: the same as the Windows release (red4ext/plugins/mod_settings), so user.ini and other mods'
+# expectations do not change.
+set(MOD_SETTINGS_FOLDER "mod_settings")
+
+file(GLOB MS_SOURCES CONFIGURE_DEPENDS
+    "${ROOT}/src/red4ext/*.cpp"
+    "${ROOT}/src/red4ext/Hooks/*.cpp")
+# Scripting/RTTIRegistrar.cpp is dead code upstream (RegisterPending is commented out in Main.cpp) and uses
+# RTTIRegistrator::Add, which the current SDK no longer has; RedLib does the type registration.
+list(APPEND MS_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/src/MacPlatform.cpp")
+
+add_library(ModSettings SHARED ${MS_SOURCES})
+set_target_properties(ModSettings PROPERTIES OUTPUT_NAME "mod_settings" PREFIX "" SUFFIX ".dylib")
+
+# macos/include comes first: it holds the macOS variants of headers from deps/ (Registrar.hpp, CyberpunkMod.hpp,
+# ArchiveXL.hpp, RedLib.hpp and the two jackhumbert SDK user-settings headers) without editing the submodules.
+target_include_directories(ModSettings PRIVATE
+    "${CMAKE_CURRENT_SOURCE_DIR}/include"
+    "${ROOT}/src/red4ext"
+    "${ROOT}/include"
+    "${CMAKE_CURRENT_SOURCE_DIR}/vendor/RedLib"
+    "${CMAKE_CURRENT_SOURCE_DIR}/vendor/nameof/include"
+    "${ROOT}/deps/cpcmake/include"
+    "${RED4EXT_SDK_DIR}/include")
+
+target_compile_definitions(ModSettings PRIVATE
+    RED4EXT_PLATFORM_MACOS
+    MOD_SETTINGS_DLLDIR_EX
+    MOD_VERSION_STR="${PROJECT_VERSION}"
+    MOD_VERSION_MAJOR=${PROJECT_VERSION_MAJOR}
+    MOD_VERSION_MINOR=${PROJECT_VERSION_MINOR}
+    MOD_VERSION_PATCH=${PROJECT_VERSION_PATCH})
+
+target_compile_options(ModSettings PRIVATE
+    -include "${CMAKE_CURRENT_SOURCE_DIR}/include/ModSettingsMac.hpp"
+    -fvisibility=hidden
+    -fvisibility-inlines-hidden
+    -Wno-deprecated-declarations
+    -Wno-microsoft-template
+    -Wno-return-type
+    -Wno-invalid-offsetof)
+
+target_link_options(ModSettings PRIVATE -undefined dynamic_lookup)
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Redscript: packed.reds + module.reds, generated from src/redscript with cyberpunk_cmake's own PackFiles.cmake and
+# Module.reds.in, as configure_redscript does on Windows. The macOS launcher
+# (RED4ext scripts/launch_red4ext.sh) compiles red4ext/plugins/<plugin>/Scripts/ with the game's scc.
+set(MS_REDSCRIPT_DIR "${ROOT}/src/redscript")
+file(GLOB_RECURSE MS_REDSCRIPT_SOURCES CONFIGURE_DEPENDS "${MS_REDSCRIPT_DIR}/*.reds")
+set(MS_PACKED_REDS "${CMAKE_CURRENT_BINARY_DIR}/redscript/packed.reds")
+set(MS_MODULE_REDS "${CMAKE_CURRENT_BINARY_DIR}/redscript/module.reds")
+# Header.txt values as in the top-level configure_mod() call.
+set(MOD_NAME "Mod Settings")
+set(MOD_VERSION_STR "${PROJECT_VERSION}")
+set(MOD_COPYRIGHT "Copyright (c) 2023 Jack Humbert. All rights reserved.")
+set(MOD_LICENSE "Licensed under the MIT license. See the license.md in the root project for details.")
+set(MOD_URL "https://github.com/jackhumbert/mod_settings")
+set(MS_HEADER_TXT "${CMAKE_CURRENT_BINARY_DIR}/redscript/Header.txt")
+configure_file("${ROOT}/deps/cpcmake/files/Header.txt.in" "${MS_HEADER_TXT}")
+add_custom_command(
+    OUTPUT "${MS_PACKED_REDS}"
+    COMMAND "${CMAKE_COMMAND}" -DCOMMENT_SLUG=// -DGLOB_EXT=reds -DHEADER_FILE=${MS_HEADER_TXT}
+        -DPACKED_FILE=${MS_PACKED_REDS} -DSEARCH_FOLDER=${MS_REDSCRIPT_DIR}
+        -P "${ROOT}/deps/cpcmake/scripts/PackFiles.cmake"
+    DEPENDS ${MS_REDSCRIPT_SOURCES} "${MS_HEADER_TXT}"
+    COMMENT "Packing src/redscript into packed.reds (cyberpunk_cmake PackFiles.cmake)"
+    VERBATIM)
+configure_file("${MS_REDSCRIPT_DIR}/Module.reds.in" "${MS_MODULE_REDS}" @ONLY)
+
+# ---------------------------------------------------------------------------------------------------------------------
+# Install layout: build-mac/package/red4ext/plugins/mod_settings/
+set(MS_PACKAGE_DIR "${CMAKE_CURRENT_BINARY_DIR}/package/red4ext/plugins/${MOD_SETTINGS_FOLDER}")
+add_custom_target(ModSettingsPackage ALL
+    COMMAND "${CMAKE_COMMAND}" -E make_directory "${MS_PACKAGE_DIR}/Scripts"
+    COMMAND "${CMAKE_COMMAND}" -E copy "$<TARGET_FILE:ModSettings>" "${MS_PACKAGE_DIR}/mod_settings.dylib"
+    COMMAND "${CMAKE_COMMAND}" -E copy "${MS_PACKED_REDS}" "${MS_PACKAGE_DIR}/Scripts/packed.reds"
+    COMMAND "${CMAKE_COMMAND}" -E copy "${MS_MODULE_REDS}" "${MS_PACKAGE_DIR}/Scripts/module.reds"
+    COMMAND "${CMAKE_COMMAND}" -E copy "${ROOT}/src/wolvenkit/packed/archive/pc/mod/ModSettings.archive"
+        "${MS_PACKAGE_DIR}/ModSettings.archive"
+    COMMAND "${CMAKE_COMMAND}" -E copy "${ROOT}/src/archiveXL/ModSettings.archive.xl"
+        "${MS_PACKAGE_DIR}/ModSettings.archive.xl"
+    COMMAND "${CMAKE_COMMAND}" -E copy "${ROOT}/readme.md" "${MS_PACKAGE_DIR}/readme.md"
+    COMMAND "${CMAKE_COMMAND}" -E copy "${ROOT}/license.md" "${MS_PACKAGE_DIR}/license.md"
+    DEPENDS ModSettings "${MS_PACKED_REDS}" "${MS_MODULE_REDS}"
+    COMMENT "Staging the install layout in ${MS_PACKAGE_DIR}"
+    VERBATIM)
